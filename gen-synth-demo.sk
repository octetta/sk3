# ======================================================================
#  SK3 VINTAGE ANALOG SYNTHESIS SUITE (SCENE-BASED SYNTH SHOWCASE)
#  File: gen-synth-demo.sk
#
#  Featuring 4 Iconic Hardware Synthesizer Architectures:
#    Scene 0: scene_moog_bass  (Minimoog Model D 1970 3-Oscillator Analog Bass)
#    Scene 1: scene_prophet    (Sequential Prophet-5 1978 Hard Sync & Curtis Brass)
#    Scene 2: scene_korg       (Korg MS-20 1978 Dual Screamer Filter & Ring Mod)
#    Scene 3: scene_jupiter    (Roland Jupiter-8 1981 Stereo Dual-Osc Arpeggio)
#
#  100% Native Synth Engine DSP:
#    - Band-limited PolyBLEP oscillators (Saw, Pulse, Triangle)
#    - Oscillator hard-sync master-slave phase alignment (HS)
#    - Hardware-accurate Pulse-Width Modulation (pw, pwt, pwd, PW)
#    - Multimode ladder lowpass with screamer & driven characters (j1 0, j1 1, j1 2)
#    - Analog cubic soft-clipping saturation drive (jd)
#    - Cross-domain ADSR envelopes across amp (t), pitch (pt/pd), filter (kt/kd), PWM (pwt/pwd)
#    - Audio-rate ring modulation (XM)
#    - Analog glissando portamento (g)
#    - Tempo-synced ping-pong stereo space echo (DS/DL/DD/DP)
#    - Real-time control plane downbeat scene triggers (ce0..ce3)
# ======================================================================

[===============================================================] puts
[   SK3 VINTAGE ANALOG SYNTHESIZER CAPABILITY SHOWCASE          ] puts
[===============================================================] puts

V -2.5
M 116 16

# ----------------------------------------------------------------------
# 1. PROCEDURAL PERCUSSION FOR GROOVE POCKET ([drum:xxx] gen!)
# Synthesizes tight vintage analog drum elements into wavetables 100..102
# ----------------------------------------------------------------------
# Slot 100: Tight 808-style analog punch kick
[drum:kick p:140 end:42 d:0.28 c:0.25 drive:0.3] 100 gen!
[Pocket Kick] wt 100

# Slot 101: Crisp analog closed hi-hat
[drum:hat open:0 d:0.038] 101 gen!
[Closed Hat] wt 101

# Slot 102: Snappy electro snare drum
[drum:snare snap:0.75 d:0.08 tail:0.18 f:2800] 102 gen!
[Pocket Snare] wt 102

# Pocket Drum Voices (sitting back in mix with ample headroom)
v9 w102 f440 a-4.5 p0
[Pocket Snare] vt

v10 w100 f440 a-3.5 p0
[Pocket Kick] vt

v11 w101 f440 a-8.0 p.20
[Pocket Hat] vt

# ----------------------------------------------------------------------
# 2. TEMPO-SYNCED STEREO SPACE DELAY BUS (For Jupiter-8 and Ambience)
# ----------------------------------------------------------------------
# Bus 1: 16th-note ping-pong stereo delay synced to 116 BPM
DS 1 116 .25
DL 1 - - 5 2 2 8
DD 1 5 3
DP 1 1

# ----------------------------------------------------------------------
# 3. SYNTHESIZER VOICE ARCHITECTURES
# ----------------------------------------------------------------------

# ======================================================================
# STYLE 1: MINIMOOG MODEL D 3-OSCILLATOR ANALOG BASS (Voices 0..3)
# ======================================================================
# LFO Voice (Voice 3): 0.85 Hz Sine wave dedicated to pulse width modulation
# Muted from master mix (m1) so it acts purely as a CV/LFO modulation source
v3 w0 f0.85 a1.0 m1
[PWM LFO Modulator] vt

# Sub-Oscillator (Voice 2): 1 Octave Down Sub Square for bottom-end weight
# Slaved to Voice 0 via G1,2 and H1,2
v2 w1 pw 0.50 N-12,0 a-4.5 p0 t.002,.30,.55,.08 g0.045 j1 k240 q1.2
[Moog Sub-Osc] vt

# PWM Pulse Oscillator (Voice 1): PolyBLEP Pulse with Detune & Dynamic PWM
# Features:
#   - N0,5: Detuned by +5 cents for rich analog beating
#   - pw 0.40: Baseline 40% pulse width
#   - pwt .02,.32,.20,.05 pwd 0.25: Dynamic per-note pulse-width envelope sweep
#   - PW 3 0.20: Continuous organic LFO pulse-width sweep from Voice 3
#   - j1,1 k125 q3.5 jd2.2 kt.002,.24,.15,.08 kd1700: Driven ladder filter & env
v1 w1 pw 0.40 N0,5 a-5.0 p0 t.002,.26,.45,.08 g0.045
v1 pwt .02,.32,.20,.05 pwd 0.25 PW 3 0.20
v1 j1,1 k125 q3.5 jd2.2 kt.002,.24,.15,.08 kd1700
[Moog Pulse PWM] vt

# Lead Core Oscillator (Voice 0): PolyBLEP Sawtooth with Pitch Snap & Master Links
# Features:
#   - w3: Band-limited PolyBLEP Sawtooth
#   - pt.001,.035,0,.01 pd 0.08: Fast pitch snap transient on note attack
#   - g 0.045: Slinky 45ms analog glissando portamento
#   - j1,1 k115 q3.8 jd2.2: Driven ladder lowpass with cubic saturation
#   - kt.002,.24,.15,.08 kd1850: Classic snappy Moog filter envelope
#   - t.002,.26,.45,.08: Tight punchy amplitude envelope
#   - G1,2 H1,2: Master link forwarding gate/pitch and velocity to Voices 1 & 2
v0 w3 a-3.5 p0 t.002,.26,.45,.08 g0.045
v0 pt.001,.035,0,.01 pd 0.08
v0 j1,1 k115 q3.8 jd2.2 kt.002,.24,.15,.08 kd1850
v0 G1,2 H1,2
[Moog Saw Core] vt

# ======================================================================
# STYLE 2: SEQUENTIAL CIRCUITS PROPHET-5 HARD SYNC & CURTIS BRASS (Voices 4..6)
# ======================================================================
# Master Voice (Voice 4): PolyBLEP Sawtooth establishing root pitch.
# Slaves Voice 5 phase via hard-sync (HS 5), and links gate/velo (G5,6 H5,6)
v4 w3 a-4.5 p-.15 t.002,.28,.50,.10 j1,1 k450 q2.6 jd1.6 kt.002,.26,.20,.08 kd2600
v4 HS 5 G5,6 H5,6
[Prophet Master Saw] vt

# Slave Voice (Voice 5): PolyBLEP Sawtooth hard-synced to Voice 4.
# Pitch envelope sweeps 1.8 octaves per note (pt/pd), creating the iconic tearing
# harmonic laser sweep of "Cars" / "Let's Go" while pitch stays locked to Voice 4!
v5 w3 a-4.5 p.15 t.002,.28,.50,.10 j1,1 k520 q2.8 jd1.6 kt.002,.26,.20,.08 kd2400
v5 pt.002,.24,0,.06 pd 1.8 N0,7
[Prophet Sync Slave] vt

# Poly-Brass Detuned Voice (Voice 6): Warm Curtis CEM-style detuned saw layer
v6 w3 a-6.0 p0 t.002,.30,.55,.10 j1,1 k380 q2.0 jd1.4 kt.002,.26,.25,.08 kd2200 N0,4
[Prophet Poly-Brass] vt

# ======================================================================
# STYLE 3: EARLY KORG MS-20 SCREAMER DUAL FILTER & RING MOD (Voices 7..8)
# ======================================================================
# Modulator Oscillator (Voice 8): High square wave (+19 semitones)
# Fed into Voice 7 ring modulator (XM 8) for raw metallic Korg grit
v8 w1 pw 0.50 N19,0 a-9.0 p0 m1
[Korg MS-20 Mod Ring] vt

# Primary Voice (Voice 7): Raw PolyBLEP Sawtooth through Korg-35 Screamer Filter
# Features:
#   - j1,2: Filter character 2 ("screamer") narrowing resonant bandwidth
#   - k 380 q 5.2 jd 3.2: Screaming self-oscillating peak + hot analog drive
#   - XM 8 0.55: Audio-rate ring modulation from Voice 8
#   - kt.001,.18,.10,.05 kd 2900: Spiky, biting attack envelope
v7 w3 a-3.5 p0 t.001,.20,.35,.05 g0.035
v7 j1,2 k380 q5.2 jd3.2 kt.001,.18,.10,.05 kd2900
v7 XM 8 0.55
[Korg MS-20 Screamer] vt

# ======================================================================
# STYLE 4: ROLAND JUPITER-8 STEREO DUAL-OSC ARPEGGIO (Voices 12..14)
# ======================================================================
# Left Channel Saw Voice (Voice 12): PolyBLEP Saw through silky IR3109 clean filter
# Panned left (-0.45), sent to tempo-synced ping-pong delay (ds 0.32)
# Slaves Voices 13 & 14 via G13,14 H13,14
v12 w3 p-.45 a-5.0 t.003,.24,.40,.12 j1,0 k650 q2.2 kt.003,.26,.25,.10 kd3400 ds 0.32
v12 G13,14 H13,14
[Jupiter-8 Saw Left] vt

# Right Channel Pulse PWM Voice (Voice 13): PolyBLEP Pulse with subtle PWM
# Panned right (+0.45), detuned +6 cents (N0,6) for wide Roland stereo chorus
v13 w1 pw 0.42 N0,6 p.45 a-5.5 t.003,.24,.40,.12 j1,0 k680 q2.2 kt.003,.26,.25,.10 kd3200 ds 0.32
[Jupiter-8 PWM Right] vt

# Center Sub-Cushion Voice (Voice 14): Warm triangle wave 1 octave down (N-12,0)
v14 w4 N-12,0 p0 a-6.5 t.003,.30,.55,.12 j1,0 k380 q1.0
[Jupiter-8 Sub Center] vt

# ----------------------------------------------------------------------
# 4. 4-BAR NOTE STREAMS (/SS 0..3)
# ----------------------------------------------------------------------

# Stream 0: Moog Funk Bassline (D Minor, 64 steps)
[
  D2 . D1 .  . D2 F2 .  G2 . Ab2 A2  . D2 C2 .
  D2 . D1 .  . D2 F2 .  G2 . A2 C3   . D3 C3 A2
  D2 . D1 .  . D2 F2 .  G2 . Ab2 A2  . D2 C2 .
  F2 . F2 .  G2 . Ab2 A2  . C3 . D3  . C2 D1 -
] n>d /SS 0

# Stream 1: Prophet-5 Hard Sync New Wave Lead (A Minor / F, 64 steps)
[
  A2 . A2 .  C3 . D3 .  E3 . G3 .  E3 D3 C3 .
  F2 . F2 .  A2 . C3 .  D3 . E3 .  G3 . A3 .
  D3 . D3 .  F3 . G3 .  A3 . G3 .  F3 E3 D3 .
  E3 . E3 .  G3 . F3 .  E3 . D3 .  C3 . B2 -
] n>d /SS 1

# Stream 2: Korg MS-20 Industrial Acid Sequence (E Minor, 64 steps)
[
  E1 . E2 .  G2 . E1 .  Bb1 B1 . D2  . E2 D2 .
  E1 . E2 .  G2 . A2 .  Bb2 B2 . D3  . E3 D3 B2
  E1 . E2 .  G2 . E1 .  Bb1 B1 . D2  . E2 D2 .
  G2 . G2 .  Ab2 A2 . Bb2  B2 . D3 .  C3 B2 A1 -
] n>d /SS 2

# Stream 3: Roland Jupiter-8 Sparkling 80s Arpeggio (C Minor, 64 steps)
# Cascading 16ths across Cm -> Ab -> Bb -> Gm with soaring high turnaround
[
  C3 G3 C4 Eb4  G4 Eb4 C4 G3  C3 G3 C4 Eb4  G4 Eb4 C4 G3
  Ab2 Eb3 Ab3 C4  Eb4 C4 Ab3 Eb3  Ab2 Eb3 Ab3 C4  Eb4 C4 Ab3 Eb3
  Bb2 F3 Bb3 D4  F4 D4 Bb3 F3  Bb2 F3 Bb3 D4  F4 D4 Bb3 F3
  G2 D3 G3 Bb3  D4 Bb3 G3 D3  G3 Bb3 D4 G4  D4 Bb3 G3 -
] n>d /SS 3

# ----------------------------------------------------------------------
# 5. STEP SEQUENCER PATTERNS
# ----------------------------------------------------------------------

# --- SCENE 0 PATTERNS: MOOG ANALOG BASS ---
y0 %1
[Moog Bass Groove] yt
yl 16
[v0 i&0] x0,1,2,3,4,5,6,7
[v0 i&0] x8,9,10,11,12,13,14,15

y1 %1
[Pocket Kick] yt
yl 16
[v10 l1] x0,6,10,14

y2 %1
[16th Pocket Hats] yt
yl 16
[v11 l.42] x0,2,4,6,8,10,12,14
[v11 l.25] x1,3,5,7,9,11,13,15

y124 %1
[Conductor Scene 0] yt
yl 64
[ce0] x0

# --- SCENE 1 PATTERNS: PROPHET-5 HARD SYNC ---
y10 %1
[Prophet Sync Lead] yt
yl 16
[v4 i&1] x0,1,2,3,4,5,6,7
[v4 i&1] x8,9,10,11,12,13,14,15

y11 %1
[Prophet Kick & Snare] yt
yl 16
[v10 l1] x0,4,8,12
[v9 l.9] x4,12

y12 %1
[Prophet Sizzle Hats] yt
yl 16
[v11 l.45] x0,2,4,6,8,10,12,14
[v11 l.28] x1,3,5,7,9,11,13,15

y125 %1
[Conductor Scene 1] yt
yl 64
[ce1] x0

# --- SCENE 2 PATTERNS: KORG MS-20 SCREAMER ---
y20 %1
[Korg Screamer Acid] yt
yl 16
[v7 i&2] x0,1,2,3,4,5,6,7
[v7 i&2] x8,9,10,11,12,13,14,15

y21 %1
[Korg Hard Kick] yt
yl 16
[v10 l1.0] x0,3,6,8,10,14

y22 %1
[Korg Snare & Hats] yt
yl 16
[v9 l.95] x4,12
[v11 l.35] x2,6,10,14

y126 %1
[Conductor Scene 2] yt
yl 64
[ce2] x0

# --- SCENE 3 PATTERNS: ROLAND JUPITER-8 ARPEGGIO ---
y30 %1
[Jupiter-8 Stereo Arp] yt
yl 16
[v12 i&3] x0,1,2,3,4,5,6,7
[v12 i&3] x8,9,10,11,12,13,14,15

y31 %1
[Jupiter Four-on-Floor Kick] yt
yl 16
[v10 l1] x0,4,8,12

y32 %1
[Jupiter 16th Dynamic Hats] yt
yl 16
[v11 l.48] x0,2,4,6,8,10,12,14
[v11 l.26] x1,3,5,7,9,11,13,15

y127 %1
[Conductor Scene 3] yt
yl 64
[ce3] x0

# ----------------------------------------------------------------------
# 6. CONTROL PLANE DISPATCHER & REAL-TIME CLI CONSOLE BANNERS
# ----------------------------------------------------------------------
# Start the background control event dispatch thread
/cer 1

# Disable master pattern sync locking so 4-bar scenes advance smoothly
yp -1

# Responder macros triggered by control plane events (ce0..ce3) on scene start
[scene_moog_puts]    : [>>> SCENE 0: MINIMOOG MODEL D (3-Osc Bass + Driven Ladder + Portamento) <<<] puts ;
[scene_prophet_puts] : [>>> SCENE 1: SEQUENTIAL PROPHET-5 (Hard Sync Tearing Lead & Curtis Brass) <<<] puts ;
[scene_korg_puts]    : [>>> SCENE 2: EARLY KORG MS-20 (Dual Screamer Filter + Metallic Ring Mod) <<<] puts ;
[scene_jupiter_puts] : [>>> SCENE 3: ROLAND JUPITER-8 (Lush Stereo Arpeggio + Roland Space Echo) <<<] puts ;

# Bind responders to user control event IDs 0..3
[scene_moog_puts]    /ceb 4 0
[scene_prophet_puts] /ceb 4 1
[scene_korg_puts]    /ceb 4 2
[scene_jupiter_puts] /ceb 4 3

# ----------------------------------------------------------------------
# 7. SCENE DEFINITIONS & AUTOMATED PROGRESSION
# Lanes:
#   Lane 0: Synth Lead/Bass Track (y0 / y10 / y20 / y30)
#   Lane 1: Kick Drum Track (y1 / y11 / y21 / y31)
#   Lane 2: Snare / Hats Track (y2 / y12 / y22 / y32)
#   Lane 7: Master Conductor Pattern (y124 / y125 / y126 / y127)
# ----------------------------------------------------------------------

# Scene 0: Minimoog Model D 3-Oscillator Analog Bass Showcase
( 0  1  2 -1 -1 -1 -1 124 ) scene_define 0

# Scene 1: Sequential Circuits Prophet-5 Hard Sync Lead & Poly-Brass
( 10 11 12 -1 -1 -1 -1 125 ) scene_define 1

# Scene 2: Early Korg MS-20 Screamer Filter & Ring Mod
( 20 21 22 -1 -1 -1 -1 126 ) scene_define 2

# Scene 3: Roland Jupiter-8 Stereo Dual-Osc Arpeggiator & Delay
( 30 31 32 -1 -1 -1 -1 127 ) scene_define 3

# Automated 4-bar scene progression cycle:
0 4 1 scene_chain
1 4 2 scene_chain
2 4 3 scene_chain
3 4 0 scene_chain

# ----------------------------------------------------------------------
# 8. PERFORMANCE MACROS & REALTIME PARAMETER TWEAKS
# ----------------------------------------------------------------------
# Filter tweaks
[filter_open]    : v0 k280 kd3200 v1 k300 kd3000 v4 k800 kd3500 v7 k750 kd3800 v12 k1200 kd4500 [Filter: Wide Open] puts ;
[filter_deep]    : v0 k80 kd1100 v1 k90 kd1000 v4 k250 kd1800 v7 k220 kd1800 v12 k450 kd2200 [Filter: Deep Sub] puts ;
[filter_normal]  : v0 k115 kd1850 v1 k125 kd1700 v4 k450 kd2600 v7 k380 kd2900 v12 k650 kd3400 [Filter: Standard Punch] puts ;
[res_high]       : v0 q6.2 v1 q5.8 v4 q5.5 v7 q7.5 v12 q4.5 [Resonance: High Peak] puts ;
[res_warm]       : v0 q3.8 v1 q3.5 v4 q2.6 v7 q5.2 v12 q2.2 [Resonance: Warm Analog Default] puts ;
[drive_hot]      : v0 jd4.5 v1 jd4.5 v4 jd3.5 v7 jd5.5 [Filter Drive: Hot Saturation] puts ;
[drive_warm]     : v0 jd2.2 v1 jd2.2 v4 jd1.6 v7 jd3.2 [Filter Drive: Warm Analog Default] puts ;
[drive_clean]    : v0 jd0.0 v1 jd0.0 v4 jd0.0 v7 jd0.0 [Filter Drive: Clean Bypass] puts ;

# Glissando / Portamento tweaks
[glide_long]     : v0 g0.12 v1 g0.12 v2 g0.12 v7 g0.09 [Glide: Long Slinky] puts ;
[glide_tight]    : v0 g0.045 v1 g0.045 v2 g0.045 v7 g0.035 [Glide: Snappy Default] puts ;
[glide_off]      : v0 g0 v1 g0 v2 g0 v7 g0 [Glide: Disabled (Staccato)] puts ;

# PWM & Hard Sync Tweaks
[pwm_wide]       : v1 pwd 0.40 PW 3 0.35 [PWM: Wide Sweeping Chorus] puts ;
[pwm_subtle]     : v1 pwd 0.15 PW 3 0.10 [PWM: Subtle Organic Movement] puts ;
[sync_wild]      : v5 pd 2.8 [Prophet Sync: Extreme Harmonic Range] puts ;
[sync_tight]     : v5 pd 1.8 [Prophet Sync: Classic Cars Snap] puts ;

# Drum Pocket Mute / Solo
[drums_off]      : v9 m1 v10 m1 v11 m1 [Pocket Drums: Muted (Pure Synth Solo)] puts ;
[drums_on]       : v9 m0 v10 m0 v11 m0 [Pocket Drums: Enabled] puts ;

# User Navigation & Scene Cues (Quantized to next bar downbeat)
[scene_moog_bass]: 0 scene_cue ;
[scene_prophet]  : 1 scene_cue ;
[scene_korg]     : 2 scene_cue ;
[scene_jupiter]  : 3 scene_cue ;

# Immediate Scene Jumps (Jump right now without waiting)
[now_moog]       : 0 scene_now ;
[now_prophet]    : 1 scene_now ;
[now_korg]       : 2 scene_now ;
[now_jupiter]    : 3 scene_now ;

# Transport Controls
[play]           : Z0 Z! scene_now 0 ;
[pause]          : scene_pause ;
[resume]         : scene_resume ;
[scenes]         : [SCENES: 0:scene_moog_bass 1:scene_prophet 2:scene_korg 3:scene_jupiter] puts ;
[controls]       : [LIVE TWEAKS: filter_open, filter_deep, filter_normal, res_high, res_warm, drive_hot, drive_warm, drive_clean, glide_long, glide_tight, glide_off, pwm_wide, sync_wild, sync_tight, drums_off, drums_on] puts ;

# ----------------------------------------------------------------------
# 9. STARTUP BANNER & ROSTER
# ----------------------------------------------------------------------
[--- VINTAGE ANALOG SYNTHESIZER CAPABILITY ROSTER ---] puts
[  Scene 0: scene_moog_bass  (Minimoog Model D 1970 3-Oscillator Analog Bass)] puts
[  Scene 1: scene_prophet    (Sequential Prophet-5 1978 Hard Sync & Curtis Brass)] puts
[  Scene 2: scene_korg       (Korg MS-20 1978 Dual Screamer Filter & Ring Mod)] puts
[  Scene 3: scene_jupiter    (Roland Jupiter-8 1981 Stereo Dual-Osc Arpeggio)] puts
[Type 'play' to start automated 4-scene arrangement from Scene 0.] puts
[Type 'scenes' to list scenes, or cue any scene macro (e.g. 'scene_prophet').] puts
[Type 'controls' to view live realtime performance parameter macros.] puts
[Scene transport: 'scene_stop' (or -1 scene_cue) to stop at bar end; 'pause' / 'resume'] puts
[===============================================================] puts
