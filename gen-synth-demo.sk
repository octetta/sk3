# ======================================================================
#  SK3 VINTAGE ANALOG SYNTHESIS SUITE (SCENE-BASED SYNTH SHOWCASE)
#  File: gen-synth-demo.sk
#
#  Featuring 5 Iconic Hardware Synthesizer Architectures:
#    Scene 0: scene_moog_bass  (Minimoog Model D 1970 3-Oscillator Analog Bass)
#    Scene 1: scene_prophet    (Sequential Prophet-5 1978 Hard Sync & Curtis Brass)
#    Scene 2: scene_korg       (Korg MS20 1978 Dual Screamer Filter & Ring Mod)
#    Scene 3: scene_jupiter    (Roland Jupiter-8 1981 Stereo Dual-Osc Arpeggio)
#    Scene 4: scene_casio_cz   (Casio CZ-101 1984 Phase Distortion DCW Reso-Synth)
#
#  100% Native Synth Engine DSP:
#    - Band-limited PolyBLEP oscillators (Saw, Pulse, Triangle)
#    - Casio CZ Phase Distortion synthesis (c 1..8, ct DCW envelope, cd depth)
#    - Oscillator hard-sync master-slave phase alignment (HS)
#    - Hardware-accurate Pulse-Width Modulation (pw, pwt, pwd, PW)
#    - Multimode ladder lowpass with screamer & driven characters (j1 0, j1 1, j1 2)
#    - Analog cubic soft-clipping saturation drive (jd)
#    - Cross-domain ADSR envelopes across amp (t), pitch (pt/pd), filter (kt/kd), PWM (pwt/pwd), CZ (ct/cd)
#    - Audio-rate ring modulation (XM)
#    - Analog glissando portamento (g)
#    - Tempo-synced ping-pong stereo space echo (DS/DL/DD/DP)
#    - Real-time control plane downbeat scene triggers (ce0..ce4)
# ======================================================================

[===============================================================] puts
[   SK3 VINTAGE ANALOG SYNTHESIZER CAPABILITY SHOWCASE          ] puts
[===============================================================] puts

V -2.5
M 116 16

# ----------------------------------------------------------------------
# 1. PROCEDURAL PERCUSSION FOR GROOVE POCKET ([drum:xxx] gen!)
# Synthesizes tight vintage analog drum elements into wavetables 100..102
# ----------------------------------------------------------------------
# Slot 100: Tight 808-style analog punch kick
[drum:kick p:140 end:42 d:0.28 c:0.25 drive:0.3] 100 gen!
[Pocket Kick] wt 100

# Slot 101: Crisp analog closed hi-hat
[drum:hat open:0 d:0.038] 101 gen!
[Closed Hat] wt 101

# Slot 102: Snappy electro snare drum
[drum:snare snap:0.75 d:0.08 tail:0.18 f:2800] 102 gen!
[Pocket Snare] wt 102

# Pocket Drum Voices (sitting back in mix with ample headroom)
v9 w102 f440 a-4.5 p0
[Pocket Snare] vt

v10 w100 f440 a-3.5 p0
[Pocket Kick] vt

v11 w101 f440 a-8.0 p.20
[Pocket Hat] vt

# ----------------------------------------------------------------------
# 2. TEMPO-SYNCED STEREO SPACE DELAY BUS (For Jupiter-8 and Ambience)
# ----------------------------------------------------------------------
# Bus 1: 16th-note ping-pong stereo delay synced to 116 BPM
DS 1 116 .25
DL 1 - - 5 2 2 8
DD 1 5 3
DP 1 1

# ----------------------------------------------------------------------
# 3. SYNTHESIZER VOICE ARCHITECTURES
# ----------------------------------------------------------------------

# ======================================================================
# STYLE 1: MINIMOOG MODEL D 3-OSCILLATOR ANALOG BASS (Voices 0..3)
# ======================================================================
# LFO Voice (Voice 3): 0.85 Hz Sine wave dedicated to pulse width modulation
# Muted from master mix (m1) so it acts purely as a CV/LFO modulation source
v3 w0 f0.85 a1.0 m1
[PWM LFO Modulator] vt

# Sub-Oscillator (Voice 2): 1 Octave Down Sub Square for bottom-end weight
# Slaved to Voice 0 via G1,2 and H1,2
v2 w1 pw 0.50 N-12,0 a-4.5 p0 t.002,.30,.55,.08 g0.045 j1 k240 q1.2
[Moog Sub-Osc] vt

# PWM Pulse Oscillator (Voice 1): PolyBLEP Pulse with Detune & Dynamic PWM
# Features:
#   - N0,5: Detuned by +5 cents for rich analog beating
#   - pw 0.40: Baseline 40% pulse width
#   - pwt .02,.32,.20,.05 pwd 0.25: Dynamic per-note pulse-width envelope sweep
#   - PW 3 0.20: Continuous organic LFO pulse-width sweep from Voice 3
#   - j1,1 k125 q3.5 jd 2.2 kt.002,.24,.15,.08 kd1700: Driven ladder filter & env
v1 w1 pw 0.40 N0,5 a-5.0 p0 t.002,.26,.45,.08 g0.045
v1 pwt .02,.32,.20,.05 pwd 0.25 PW 3 0.20
v1 j1,1 k125 q3.5 jd 2.2 kt.002,.24,.15,.08 kd1700
[Moog Pulse PWM] vt

# Lead Core Oscillator (Voice 0): PolyBLEP Sawtooth with Pitch Snap & Master Links
# Features:
#   - w3: Band-limited PolyBLEP Sawtooth
#   - pt.001,.035,0,.01 pd 0.08: Fast pitch snap transient on note attack
#   - g 0.045: Slinky 45ms analog glissando portamento
#   - j1,1 k115 q3.8 jd 2.2: Driven ladder lowpass with cubic saturation
#   - kt.002,.24,.15,.08 kd1850: Classic snappy Moog filter envelope
#   - t.002,.26,.45,.08: Tight punchy amplitude envelope
#   - G1,2 H1,2: Master link forwarding gate/pitch and velocity to Voices 1 & 2
v0 w3 a-3.5 p0 t.002,.26,.45,.08 g0.045
v0 pt.001,.035,0,.01 pd 0.08
v0 j1,1 k115 q3.8 jd 2.2 kt.002,.24,.15,.08 kd1850
v0 G1,2 H1,2
[Moog Saw Core] vt

# ======================================================================
# STYLE 2: SEQUENTIAL CIRCUITS PROPHET-5 CURTIS POLY-BRASS (Voices 4..6)
# ======================================================================
# Sub/Center Layer (Voice 6): Warm pulse with subtle PWM 1 octave down
v6 w1 pw 0.38 N-12,0 a-5.0 p0 t.010,.35,.60,.15 j1,1 k240 q1.8 jd 1.4 kt.012,.32,.30,.12 kd1800
[Prophet Sub-Pulse] vt

# Right Detuned Saw (Voice 5): PolyBLEP Saw detuned +6 cents for lush Curtis beating
v5 w3 N0,6 a-4.5 p.20 t.010,.35,.60,.15 j1,1 k300 q2.2 jd 1.5 kt.012,.32,.30,.12 kd2400
[Prophet Detune Saw] vt

# Left Core Saw (Voice 4): PolyBLEP Saw establishing root pitch, slaving v5 & v6
v4 w3 a-4.0 p-.20 t.010,.35,.60,.15 j1,1 k280 q2.2 jd 1.5 kt.012,.32,.30,.12 kd2400 G5,6 H5,6
[Prophet Core Saw] vt

# ======================================================================
# STYLE 3: EARLY KORG MS20 DUAL VCO SCREAMER (Voices 7..8)
# ======================================================================
# VCO 2 (Voice 8): PolyBLEP Pulse (pw 0.45) tuned 1 octave up + 6 cents detune
v8 w1 pw 0.45 N12,6 a-4.5 p.15 t.001,.18,.35,.04 g0.035 j1,2 k420 q5.2 jd 3.0 kt.001,.16,.10,.04 kd2800
[Korg MS20 VCO2 Pulse] vt

# VCO 1 (Voice 7): PolyBLEP Sawtooth with aggressive KORG-35 Screamer Filter (j1,2)
# Slaves Voice 8 via G8 H8
v7 w3 a-3.5 p-.15 t.001,.18,.35,.04 g0.035 j1,2 k350 q5.8 jd 3.5 kt.001,.16,.10,.04 kd3200 G8 H8
[Korg MS20 VCO1 Saw] vt

# ======================================================================
# STYLE 4: ROLAND JUPITER-8 STEREO DUAL-OSC ARPEGGIO (Voices 12..14)
# ======================================================================
# Left Channel Saw Voice (Voice 12): PolyBLEP Saw through silky IR3109 clean filter
# Panned left (-0.45), sent to tempo-synced ping-pong delay (ds 0.32)
# Slaves Voices 13 & 14 via G13,14 H13,14
v12 w3 p-.45 a-5.0 t.003,.24,.40,.12 j1,0 k650 q2.2 kt.003,.26,.25,.10 kd3400 ds 0.32
v12 G13,14 H13,14
[Jupiter-8 Saw Left] vt

# Right Channel Pulse PWM Voice (Voice 13): PolyBLEP Pulse with subtle PWM
# Panned right (+0.45), detuned +6 cents (N0,6) for wide Roland stereo chorus
v13 w1 pw 0.42 N0,6 p.45 a-5.5 t.003,.24,.40,.12 j1,0 k680 q2.2 kt.003,.26,.25,.10 kd3200 ds 0.32
[Jupiter-8 PWM Right] vt

# Center Sub-Cushion Voice (Voice 14): Warm triangle wave 1 octave down (N-12,0)
v14 w4 N-12,0 p0 a-6.5 t.003,.30,.55,.12 j1,0 k380 q1.0
[Jupiter-8 Sub Center] vt

# ======================================================================
# STYLE 5: CASIO CZ-101 / CZ-1 PHASE DISTORTION SYNTHESIS (Voices 15..17)
# ======================================================================
# Line 1 Saw Voice (Voice 15): Sine carrier distorted into saw with snappy DCW envelope
# Slaves Voices 16 & 17 via G16,17 H16,17
v15 w0 a-4.0 p-.20 c 1 0.15 ct .004,.28,.20,.08 cd 0.75 t.003,.30,.40,.08 g0.025
v15 G16,17 H16,17
[CZ-101 Line 1 Saw] vt

# Line 2 Resonant Saw Voice (Voice 16): Sine carrier distorted into Resonant 1 wave
# Detuned +5 cents (N0,5) for lush dual-line beating and subtle stereo delay send (ds 0.22)
v16 w0 a-4.5 p.20 N0,5 c 6 0.10 ct .004,.25,.15,.08 cd 0.85 t.003,.30,.40,.08 g0.025 ds 0.22
[CZ-101 Line 2 Reso] vt

# Sub-Octave Square Voice (Voice 17): Folded sine into square (c 2), 1 octave down
v17 w0 a-5.0 p0 N-12,0 c 2 0.20 ct .004,.32,.45,.10 cd 0.60 t.003,.32,.50,.10
[CZ-101 Sub Square] vt

# ----------------------------------------------------------------------
# 4. 4-BAR NOTE STREAMS (/SS 0..3)
# ----------------------------------------------------------------------

# Stream 0: Moog Funk Bassline (D Minor, 64 steps)
[
  D2 . D1 .  . D2 F2 .  G2 . Ab2 A2  . D2 C2 .
  D2 . D1 .  . D2 F2 .  G2 . A2 C3   . D3 C3 A2
  D2 . D1 .  . D2 F2 .  G2 . Ab2 A2  . D2 C2 .
  F2 . F2 .  G2 . Ab2 A2  . C3 . D3  . C2 D1 -
] n>d /SS 0

# Stream 1: Prophet-5 Anthem Poly-Brass (F Major / D Minor, 64 steps)
[
  # Bar 1: Triumphant Prophet brass stabs (F major -> A minor)
  F3 . F3 .  A3 . C4 .  D4 . C4 .  A3 . F3 .

  # Bar 2: Uplifting syncopated brass swell
  G3 . G3 .  Bb3 . D4 .  C4 . D4 .  E4 . D4 C4

  # Bar 3: Powerful rhythmic chord accents
  D3 . D3 .  F3 . A3 .  C4 . A3 .  G3 . F3 .

  # Bar 4: Harmonic resolution & turnaround
  Bb3 . Bb3 .  D4 . C4 .  A3 . G3 .  F3 . - -
] n>d /SS 1

# Stream 2: Korg MS20 Screamer Acid / EBM Sequence (E Minor, 64 steps)
[
  # Bar 1: Punchy EBM bassline with octave snaps
  E1 . E2 .  . E1 G2 .  A2 . Bb2 B2  . D2 E2 .

  # Bar 2: Screaming resonant cutoff climb
  E1 . E2 .  . E1 G2 .  A2 . B2 D3   . E3 D3 B2

  # Bar 3: Relentless syncopated drive
  E1 . E2 .  . E1 G2 .  A2 . Bb2 B2  . D2 E2 .

  # Bar 4: Chromatic turnaround with biting screamer filter bite
  G2 . G2 .  Ab2 A2 . Bb2  B2 . D3 .  C3 B2 A1 -
] n>d /SS 2

# Stream 3: Roland Jupiter-8 Sparkling 80s Arpeggio (C Minor, 64 steps)
# Cascading 16ths across Cm -> Ab -> Bb -> Gm with soaring high turnaround
[
  C3 G3 C4 Eb4  G4 Eb4 C4 G3  C3 G3 C4 Eb4  G4 Eb4 C4 G3
  Ab2 Eb3 Ab3 C4  Eb4 C4 Ab3 Eb3  Ab2 Eb3 Ab3 C4  Eb4 C4 Ab3 Eb3
  Bb2 F3 Bb3 D4  F4 D4 Bb3 F3  Bb2 F3 Bb3 D4  F4 D4 Bb3 F3
  G2 D3 G3 Bb3  D4 Bb3 G3 D3  G3 Bb3 D4 G4  D4 Bb3 G3 -
] n>d /SS 3

# Stream 4: Casio CZ-101 Vince Clarke / Synthpop Resonant Hook (A Minor, 64 steps)
[
  # Bar 1: Punchy digital CZ bass riff with snappy octave bounces
  A2 . A3 .  . A2 C3 .  D3 . Eb3 E3  . G3 A2 .

  # Bar 2: Resonant filter sweep accent turnaround
  A2 . A3 .  . A2 C3 .  D3 . E3 G3   . A3 G3 E3

  # Bar 3: Syncopated driving rhythm
  A2 . A3 .  . A2 C3 .  D3 . Eb3 E3  . G3 A2 .

  # Bar 4: Harmonic turnaround with rising resonant lead accent
  F2 . F3 .  G2 . G3 .  A3 . C4 B3   . G3 E2 -
] n>d /SS 4

# ----------------------------------------------------------------------
# 5. STEP SEQUENCER PATTERNS
# ----------------------------------------------------------------------

# --- SCENE 0 PATTERNS: MOOG ANALOG BASS ---
y0 %1
[Moog Bass Groove] yt
yl 16
[v0 i&0] x0,1,2,3,4,5,6,7
[v0 i&0] x8,9,10,11,12,13,14,15

y1 %1
[Pocket Kick] yt
yl 16
[v10 l1] x0,6,10,14

y2 %1
[16th Pocket Hats] yt
yl 16
[v11 l.42] x0,2,4,6,8,10,12,14
[v11 l.25] x1,3,5,7,9,11,13,15

y124 %1
[Conductor Scene 0] yt
yl 64
[ce0] x0

