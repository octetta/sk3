# ----------------------------------------------------------------------
# 6. CONTROL PLANE DISPATCHER & REAL-TIME CLI CONSOLE BANNERS
# ----------------------------------------------------------------------
# Start the background control event dispatch thread
/cer 1

# Disable master pattern sync locking so 4-bar scenes advance smoothly
yp -1

# Responder macros triggered by control plane events (ce0..ce7) on scene start
[scene_moog_puts] : [>>> SCENE 0: MINIMOOG MODEL D (3-Osc Bass + Driven Ladder + Portamento) <<<] puts ;
[scene_prophet_puts] : [>>> SCENE 1: SEQUENTIAL PROPHET-5 (Talking Heads Hard-Sync Funk Lead) <<<] puts ;
[scene_korg_puts] : [>>> SCENE 2: EARLY KORG MS20 (Dual VCO Screamer 35 Filter & Hot Analog Drive) <<<] puts ;
[scene_jupiter_puts] : [>>> SCENE 3: ROLAND JUPITER-8 (Lush Stereo Arpeggio + Roland Space Echo) <<<] puts ;
[scene_cz_puts] : [>>> SCENE 4: CASIO CZ-101 (Phase Distortion Reso-Bass & Stabs) <<<] puts ;
[scene_cz_bell_puts] : [>>> SCENE 5: CASIO CZ-101 (Glassy Phase Distortion Bells & Chimes) <<<] puts ;
[scene_dw_space_puts] : [>>> SCENE 6: KORG DW-8000 (2-Osc Space Arp + Modulated Digital Delay) <<<] puts ;
[scene_dw_brass_puts] : [>>> SCENE 7: KORG DW-8000 (2-Osc Hybrid Power Brass & Delay Line) <<<] puts ;

# Bind responders to user control event IDs 0..7
[scene_moog_puts]     /ceb 4 0
[scene_prophet_puts]  /ceb 4 1
[scene_korg_puts]     /ceb 4 2
[scene_jupiter_puts]  /ceb 4 3
[scene_cz_puts]       /ceb 4 4
[scene_cz_bell_puts]  /ceb 4 5
[scene_dw_space_puts] /ceb 4 6
[scene_dw_brass_puts] /ceb 4 7

# ----------------------------------------------------------------------
# 7. SCENE DEFINITIONS & AUTOMATED PROGRESSION
# Lanes:
#   Lane 0: Synth Lead/Bass Track (y0 / y10 / y20 / y30 / y40 / y50 / y60 / y70)
#   Lane 1: Kick Drum Track (y1 / y11 / y21 / y31 / y41 / y51 / y61 / y71)
#   Lane 2: Snare / Hats Track (y2 / y12 / y22 / y32 / y42 / y52 / y62 / y72)
#   Lane 7: Master Conductor Pattern (y124..y131)
# ----------------------------------------------------------------------

# Scene 0: Minimoog Model D 3-Oscillator Analog Bass Showcase
( 0  1  2 -1 -1 -1 -1 124 ) scene_define 0

# Scene 1: Sequential Prophet-5 Talking Heads Hard-Sync Funk Lead
( 10 11 12 -1 -1 -1 -1 125 ) scene_define 1

# Scene 2: Early Korg MS20 Dual VCO Screamer Filter & Drive
( 20 21 22 -1 -1 -1 -1 126 ) scene_define 2

# Scene 3: Roland Jupiter-8 Stereo Dual-Osc Arpeggiator & Delay
( 30 31 32 -1 -1 -1 -1 127 ) scene_define 3

# Scene 4: Casio CZ-101 Phase Distortion Reso-Bass & Stabs
( 40 41 42 -1 -1 -1 -1 128 ) scene_define 4

# Scene 5: Casio CZ-101 Glassy Phase Distortion Bells & Chimes
( 50 51 52 -1 -1 -1 -1 129 ) scene_define 5

# Scene 6: Korg DW-8000 2-Osc Space Arpeggio & Modulated Delay
( 60 61 62 -1 -1 -1 -1 130 ) scene_define 6

# Scene 7: Korg DW-8000 2-Osc Hybrid Power Brass & Delay Line
( 70 71 72 -1 -1 -1 -1 131 ) scene_define 7

# Automated 4-bar scene progression cycle across all 8 synthesizer scenes:
0 4 1 scene_chain
1 4 2 scene_chain
2 4 3 scene_chain
3 4 4 scene_chain
4 4 5 scene_chain
5 4 6 scene_chain
6 4 7 scene_chain
7 4 0 scene_chain

# ----------------------------------------------------------------------
# 8. PERFORMANCE MACROS & REALTIME PARAMETER TWEAKS
# ----------------------------------------------------------------------
# Filter tweaks
[filter_open] : v0 k280 kd3200 v1 k300 kd3000 v4 k650 kd3500 v7 k650 kd3800 v12 k1200 kd4500 [Filter: Wide Open] puts ;
[filter_deep] : v0 k80 kd1100 v1 k90 kd1000 v4 k200 kd1600 v7 k220 kd1800 v12 k450 kd2200 [Filter: Deep Sub] puts ;
[filter_normal] : v0 k115 kd1850 v1 k125 kd1700 v4 k280 kd2400 v7 k350 kd3200 v12 k650 kd3400 [Filter: Standard Punch] puts ;
[res_high] : v0 q6.2 v1 q5.8 v4 q4.5 v7 q7.5 v12 q4.5 [Resonance: High Peak] puts ;
[res_warm] : v0 q3.8 v1 q3.5 v4 q2.2 v7 q5.8 v12 q2.2 [Resonance: Warm Analog Default] puts ;
[drive_hot] : v0 jd 4.5 v1 jd 4.5 v4 jd 3.5 v7 jd 5.5 [Filter Drive: Hot Saturation] puts ;
[drive_warm] : v0 jd 2.2 v1 jd 2.2 v4 jd 1.5 v7 jd 3.5 [Filter Drive: Warm Analog Default] puts ;
[drive_clean] : v0 jd 0.0 v1 jd 0.0 v4 jd 0.0 v7 jd 0.0 [Filter Drive: Clean Bypass] puts ;

# Glissando / Portamento tweaks
[glide_long] : v0 g0.12 v1 g0.12 v2 g0.12 v4 g0.09 v7 g0.09 [Glide: Long Slinky] puts ;
[glide_tight] : v0 g0.045 v1 g0.045 v2 g0.045 v4 g0.038 v7 g0.035 [Glide: Snappy Default] puts ;
[glide_off] : v0 g0 v1 g0 v2 g0 v4 g0 v7 g0 [Glide: Disabled (Staccato)] puts ;

# Synth-Specific Character Tweaks
[prophet_sync_screech] : v5 pd 16.0 v4 k450 kd3200 [Prophet Talking Heads Screaming Hard Sync] puts ;
[prophet_sync_warm]    : v5 pd 8.0 v4 k280 kd2200 [Prophet Warm Vocal Hard Sync] puts ;
[korg_screech] : v7 q7.8 jd 5.0 v8 q7.2 jd 4.5 [Korg MS20 Screaming Self-Oscillation] puts ;
[korg_punch]   : v7 q5.8 jd 3.5 v8 q5.2 jd 3.0 [Korg MS20 Aggressive Industrial Punch] puts ;
[pwm_wide] : v1 pwd 0.40 PW 3 0.35 [PWM: Wide Sweeping Chorus] puts ;
[pwm_subtle] : v1 pwd 0.15 PW 3 0.10 [PWM: Subtle Organic Movement] puts ;

# Casio CZ Phase Distortion Tweaks
[cz_bright] : v15 cd 0.95 v16 cd 0.95 v17 cd 0.85 v21 cd 0.90 [Casio CZ: Max DCW Brightness] puts ;
[cz_resonant] : v16 c 6 0.15 cd 0.95 v15 c 6 0.15 cd 0.90 [Casio CZ: High Resonance Scream] puts ;
[cz_mellow] : v15 cd 0.40 v16 cd 0.35 v17 cd 0.30 v21 cd 0.45 [Casio CZ: Smooth Warm DCW] puts ;
[cz_line_saw] : v15 c 1 0.15 v16 c 1 0.10 [Casio CZ: Line 1 Saw Waveforms] puts ;
[cz_line_reso] : v15 c 1 0.15 v16 c 6 0.10 [Casio CZ: Dual Saw + Resonant 1] puts ;

# Korg DW-8000 Tweaks
[dw_delay_mod]    : DL 2 5 8 8 16 24 7 [DW-8000: Swirling Modulated Delay] puts ;
[dw_delay_tight]  : DL 2 3 4 4 0 0 5 [DW-8000: Tight Slapback Delay] puts ;
[dw_filter_open]  : v24 k950 kd3500 v26 k850 kd3500 [DW-8000: NJM2069 Filter Wide Open] puts ;
[dw_filter_warm]  : v24 k480 kd2400 v26 k420 kd2200 [DW-8000: NJM2069 Warm Resonance] puts ;

# Drum Pocket Mute / Solo
[drums_off] : v9 m1 v10 m1 v11 m1 [Pocket Drums: Muted (Pure Synth Solo)] puts ;
[drums_on] : v9 m0 v10 m0 v11 m0 [Pocket Drums: Enabled] puts ;

# User Navigation & Scene Cues (Quantized to next bar downbeat)
[scene_moog_bass]   : 0 scene_cue ;
[scene_prophet]     : 1 scene_cue ;
[scene_korg]        : 2 scene_cue ;
[scene_jupiter]     : 3 scene_cue ;
[scene_casio_cz]    : 4 scene_cue ;
[scene_cz_bass]     : 4 scene_cue ;
[scene_cz_bell]     : 5 scene_cue ;
[scene_dw_space]    : 6 scene_cue ;
[scene_dw_brass]    : 7 scene_cue ;

# Immediate Scene Jumps (Jump right now without waiting)
[now_moog]     : 0 scene_now ;
[now_prophet]  : 1 scene_now ;
[now_korg]     : 2 scene_now ;
[now_jupiter]  : 3 scene_now ;
[now_cz]       : 4 scene_now ;
[now_cz_bass]  : 4 scene_now ;
[now_cz_bell]  : 5 scene_now ;
[now_dw_space] : 6 scene_now ;
[now_dw_brass] : 7 scene_now ;

# Transport Controls
[play] : Z0 Z! scene_now 0 ;
[pause] : scene_pause ;
[resume] : scene_resume ;
[scenes] : [SCENES: 0:moog 1:prophet(talking_heads) 2:korg_ms20 3:jupiter8 4:cz_bass 5:cz_bell 6:dw_space 7:dw_brass] puts ;
[controls] : [LIVE TWEAKS: filter_open, filter_deep, res_high, drive_hot, prophet_sync_screech, prophet_sync_warm, cz_bright, cz_resonant, cz_mellow, dw_delay_mod, dw_delay_tight, dw_filter_open, dw_filter_warm, drums_off, drums_on] puts ;

