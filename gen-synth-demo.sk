# ======================================================================
#  SK3 HISTORICAL SYNTHESIS & CHIPTUNE DEMO SUITE (SCENE SHOWCASE)
#  File: gen-synth-demo.sk
#
#  Featuring 10 Hardware-Accurate Synthesizer & Chiptune Architectures:
#    Scene 0: scene_moog_bass    (Minimoog Model D 1970 3-Oscillator Analog Bass)
#    Scene 1: scene_prophet      (Sequential Prophet-5 1978 Talking Heads Bouncy Curtis Lead)
#    Scene 2: scene_korg         (Korg MS20 1978 Dual VCO Screamer Filter & Drive)
#    Scene 3: scene_jupiter      (Roland Jupiter-8 1981 Stereo Dual-Osc Arpeggio)
#    Scene 4: scene_cz_digibass  (Casio CZ-101 1984 Phase Distortion Digi-Bass & Brass Stabs)
#    Scene 5: scene_cz_bells     (Casio CZ-101 1984 Glassy Phase Distortion Bells & Space Harp)
#    Scene 6: scene_dw_organ     (Korg DW-8000 1985 2-Osc DWGS Digi-Bass & Rotary Organ)
#    Scene 7: scene_dw_brass     (Korg DW-8000 1985 2-Osc DWGS Power Brass & Cosmic Bells)
#    Scene 8: scene_sid          (Commodore 64 MOS 6581 SID DAC Non-Linearity & LFSR Noise)
#    Scene 9: scene_arcade       (Atari POKEY 4-bit Metallic Noise & NES 8-Bit Retro Chiptune)
#
#  100% Native Synth Engine DSP:
#    - Band-limited PolyBLEP oscillators (Saw, Pulse, Triangle)
#    - Casio CZ Phase Distortion synthesis (c 1..8, ct DCW envelope, cd depth)
#    - Korg DW-8000 DWGS ROM wavetables (w15..w30) with 2-oscillator architecture
#    - Hardware-accurate Korg DW-8000 digital delay line (DL/DD/DP)
#    - Commodore 64 MOS 6581 SID non-linear DAC curves (bc 8,2) & 23-bit LFSR noise (NT 0)
#    - Atari POKEY 4-bit/5-bit/9-bit/17-bit metallic LFSR noise (NT 1..4)
#    - Nintendo NES 15-bit periodic noise (NT 5) & 4-bit stepped triangle bass (bc 4,0)
#    - Decimation sample-and-hold (h) & audio-rate cross-modulation (XM/FF/PW)
#    - Driven ladder and screamer filters (j1 0, j1 1, j1 2, jd)
#    - Real-time control plane downbeat scene triggers (ce0..ce9)
# ======================================================================

[===============================================================] puts
[   SK3 VINTAGE ANALOG SYNTHESIZER CAPABILITY SHOWCASE          ] puts
[===============================================================] puts

V -3.5
M 116 16

# ----------------------------------------------------------------------
# 1. PROCEDURAL PERCUSSION FOR GROOVE POCKET ([drum:xxx] gen!)
# Synthesizes tight vintage analog drum elements into wavetables 100..102
# ----------------------------------------------------------------------
# Slot 100: Tight 808-style analog punch kick
[drum:kick p:140 end:42 d:0.28 c:0.25 drive:0.3] 100 gen!
[Pocket Kick] wt 100

# Slot 101: Crisp analog closed hi-hat
[drum:hat open:0 d:0.038] 101 gen!
[Closed Hat] wt 101

# Slot 102: Snappy electro snare drum
[drum:snare snap:0.75 d:0.08 tail:0.18 f:2800] 102 gen!
[Pocket Snare] wt 102

# Pocket Drum Voices (sitting back in mix with ample headroom)
v9 w102 f440 a-4.5 p0
[Pocket Snare] vt

v10 w100 f440 a-3.5 p0
[Pocket Kick] vt

v11 w101 f440 a-8.0 p.20
[Pocket Hat] vt

# ----------------------------------------------------------------------
# 2. DELAY BUSES (Tempo-Synced Space Delay + Korg DW-8000 Delay Line)
# ----------------------------------------------------------------------
# Bus 1: 16th-note ping-pong stereo delay synced to 116 BPM (Jupiter-8 and CZ)
DS 1 116 .25
DL 1 - - 5 2 2 8
DD 1 5 3
DP 1 1

# Bus 2: Hardware-accurate Korg DW-8000 Digital Delay Line
# Param 51: Coarse 4 (128ms), Param 52: Fine 4, Param 53: Feedback 4,
# Param 54: Mod Freq 0 (No pitch wobble), Param 55: Mod Depth 0 (Clean studio repeats), Level 4
DL 2 4 4 4 0 0 4
DD 2 8 0
DP 2 1

# ----------------------------------------------------------------------
# 3. SYNTHESIZER VOICE ARCHITECTURES
# ----------------------------------------------------------------------

# ======================================================================
# STYLE 1: MINIMOOG MODEL D 3-OSCILLATOR ANALOG BASS (Voices 0..3)
# ======================================================================
# LFO Voice (Voice 3): 0.85 Hz Sine wave dedicated to pulse width modulation
# Muted from master mix (m1) so it acts purely as a CV/LFO modulation source
v3 w0 f0.85 a1.0 m1
[PWM LFO Modulator] vt

# Sub-Oscillator (Voice 2): 1 Octave Down Sub Square for bottom-end weight
# Slaved to Voice 0 via G1,2 and H1,2
v2 w1 pw 0.50 N-12,0 a-4.5 p0 t.002,.30,.55,.08 g0.045 j1 k240 q1.2
[Moog Sub-Osc] vt

# PWM Pulse Oscillator (Voice 1): PolyBLEP Pulse with Detune & Dynamic PWM
# Features:
#   - N0,5: Detuned by +5 cents for rich analog beating
#   - pw 0.40: Baseline 40% pulse width
#   - pwt .02,.32,.20,.05 pwd 0.25: Dynamic per-note pulse-width envelope sweep
#   - PW 3 0.20: Continuous organic LFO pulse-width sweep from Voice 3
#   - j1,1 k125 q3.5 jd 2.2 kt.002,.24,.15,.08 kd1700: Driven ladder filter & env
v1 w1 pw 0.40 N0,5 a-5.0 p0 t.002,.26,.45,.08 g0.045
v1 pwt .02,.32,.20,.05 pwd 0.25 PW 3 0.20
v1 j1,1 k125 q3.5 jd 2.2 kt.002,.24,.15,.08 kd1700
[Moog Pulse PWM] vt

# Lead Core Oscillator (Voice 0): PolyBLEP Sawtooth with Pitch Snap & Master Links
# Features:
#   - w3: Band-limited PolyBLEP Sawtooth
#   - pt.001,.035,0,.01 pd 0.08: Fast pitch snap transient on note attack
#   - g 0.045: Slinky 45ms analog glissando portamento
#   - j1,1 k115 q3.8 jd 2.2: Driven ladder lowpass with cubic saturation
#   - kt.002,.24,.15,.08 kd1850: Classic snappy Moog filter envelope
#   - t.002,.26,.45,.08: Tight punchy amplitude envelope
#   - G1,2 H1,2: Master link forwarding gate/pitch and velocity to Voices 1 & 2
v0 w3 a-3.5 p0 t.002,.26,.45,.08 g0.045
v0 pt.001,.035,0,.01 pd 0.08
v0 j1,1 k115 q3.8 jd 2.2 kt.002,.24,.15,.08 kd1850
v0 G1,2 H1,2
[Moog Saw Core] vt

# ======================================================================
# STYLE 2: SEQUENTIAL PROPHET-5 TALKING HEADS BOUNCY LEAD (Voices 4..6)
# ======================================================================
# Inspired by Bernie Worrell in 'This Must Be the Place' & 'Girlfriend Is Better':
# Warm, rounded, buoyant dual-oscillator lead with subtle detune beating,
# sweet 24dB Curtis lowpass filter snap, slippery portamento, and space delay.
# Osc A (Voice 4): PolyBLEP Saw establishing fundamental pitch, slaving v5 & v6
v4 w3 a-3.0 p-.15 t.004,.28,.50,.10 g0.035 j1,1 k380 q2.4 jd 1.4 kt.004,.24,.30,.10 kd2200 ds 0.25
v4 G5,6 H5,6
[Prophet Lead Saw] vt

# Osc B (Voice 5): PolyBLEP Pulse (pw 0.48) detuned +5 cents for lush chorus shimmer
v5 w1 pw 0.48 N0,5 a-3.5 p.15 t.004,.28,.50,.10 g0.035 j1,1 k400 q2.4 jd 1.4 kt.004,.24,.30,.10 kd2200 ds 0.25
[Prophet Lead Pulse] vt

# Sub-Oscillator (Voice 6): Warm square 1 octave down for beefy foundation
v6 w1 pw 0.50 N-12,0 a-5.0 p0 t.004,.30,.60,.10 j1,1 k240 q1.5 jd 1.0
[Prophet Sub-Square] vt

# ======================================================================
# STYLE 3: EARLY KORG MS20 DUAL VCO SCREAMER (Voices 7..8)
# ======================================================================
# VCO 2 (Voice 8): PolyBLEP Pulse (pw 0.45) tuned 1 octave up + 6 cents detune
v8 w1 pw 0.45 N12,6 a-3.0 p.15 t.001,.18,.35,.04 g0.035 j1,2 k420 q5.2 jd 3.0 kt.001,.16,.10,.04 kd2800
[Korg MS20 VCO2 Pulse] vt

# VCO 1 (Voice 7): PolyBLEP Sawtooth with aggressive KORG-35 Screamer Filter (j1,2)
# Slaves Voice 8 via G8 H8
v7 w3 a-2.0 p-.15 t.001,.18,.35,.04 g0.035 j1,2 k350 q5.8 jd 3.5 kt.001,.16,.10,.04 kd3200 G8 H8
[Korg MS20 VCO1 Saw] vt

# ======================================================================
# STYLE 4: ROLAND JUPITER-8 STEREO DUAL-OSC ARPEGGIO (Voices 12..14)
# ======================================================================
# Left Channel Saw Voice (Voice 12): PolyBLEP Saw through silky IR3109 clean filter
# Panned left (-0.45), sent to tempo-synced ping-pong delay (ds 0.32)
# Slaves Voices 13 & 14 via G13,14 H13,14
v12 w3 p-.45 a-5.0 t.003,.24,.40,.12 j1,0 k650 q2.2 kt.003,.26,.25,.10 kd3400 ds 0.32
v12 G13,14 H13,14
[Jupiter-8 Saw Left] vt

# Right Channel Pulse PWM Voice (Voice 13): PolyBLEP Pulse with subtle PWM
# Panned right (+0.45), detuned +6 cents (N0,6) for wide Roland stereo chorus
v13 w1 pw 0.42 N0,6 p.45 a-5.5 t.003,.24,.40,.12 j1,0 k680 q2.2 kt.003,.26,.25,.10 kd3200 ds 0.32
[Jupiter-8 PWM Right] vt

# Center Sub-Cushion Voice (Voice 14): Warm triangle wave 1 octave down (N-12,0)
v14 w4 N-12,0 p0 a-6.5 t.003,.30,.55,.12 j1,0 k380 q1.0
[Jupiter-8 Sub Center] vt

# ======================================================================
# STYLE 5: CASIO CZ-101 DIGI-BASS & RESO BRASS STABS (Voices 15..18)
# ======================================================================
# Iconic CZ-101 Preset 11 Reso-Bass with punchy Phase Distortion DCW envelope:
# Voice 15 (Reso-Bass Core): CZ Line 6 (Resonant Saw) with snappy DCW twang
# Slaves Voice 16 via G16 H16
v15 w0 a-3.5 p-.15 c 6 0.20 ct .003,.22,.10,.06 cd 0.88 t.002,.25,.40,.08 g0.025
v15 G16 H16
[CZ-101 Reso-Bass Line 6] vt

# Voice 16 (Folded Square Sub): CZ Line 2 (Folded Sine Square) 1 octave down
v16 w0 a-4.5 p0 N-12,0 c 2 0.20 ct .003,.28,.35,.08 cd 0.60 t.002,.28,.45,.08
[CZ-101 Sub Square Line 2] vt

# Voice 17 (Digi-Brass Line 1 Swell): CZ Line 1 (Saw) with slow-opening DCW envelope
# Slaves Voice 18 via G18 H18 for stereo detuned analog brass richness
v17 w0 a-3.5 p.25 c 1 0.15 ct .015,.35,.50,.10 cd 0.80 t.010,.35,.50,.10 ds 0.30
v17 G18 H18
[CZ-101 Digi Brass Line 1] vt

# Voice 18 (Digi-Brass Line 2 Detune): CZ Line 1 (Saw) detuned +7 cents
v18 w0 a-4.5 p-.25 N0,7 c 1 0.15 ct .015,.35,.50,.10 cd 0.80 t.010,.35,.50,.10 ds 0.30
[CZ-101 Digi Brass Line 2] vt

# ======================================================================
# STYLE 6: CASIO CZ-101 SPACE HARP & GLASS BELLS (Voices 19..22)
# ======================================================================
# Iconic CZ Preset 14 'Space Harp' (Voices 19 & 20):
# Voice 19 (Space Harp Core): CZ Line 5 (Saw->Triangle) fast percussive pluck
# Slaves Voice 20 via G20 H20, sent through rich stereo delay (ds 0.45)
v19 w0 a-3.5 p-.25 c 5 0.12 ct .001,.38,0,.22 cd 0.85 t.001,.45,0,.22 ds 0.45
v19 G20 H20
[CZ-101 Space Harp Line 5] vt

# Voice 20 (Space Harp Sub): CZ Line 3 (Triangle) 1 octave down for body
v20 w0 a-4.5 p.25 N-12,0 c 3 0.10 ct .001,.38,0,.22 cd 0.70 t.001,.45,0,.22 ds 0.45
[CZ-101 Space Harp Sub] vt

# Iconic CZ Preset 9 'Glass Bells & Chimes' (Voices 21 & 22):
# Voice 21 (Crystal Bell Core): CZ Line 4 (Double Sine) with glassy DCW decay & long release
# Slaves Voice 22 via G22 H22, delay send ds 0.45
v21 w0 a-3.0 p.20 c 4 0.25 ct .002,1.0,.20,.70 cd 0.75 t.002,1.2,.30,.80 ds 0.45
v21 G22 H22
[CZ Glass Bell Line 4] vt

# Voice 22 (Shimmering Overtone): CZ Line 7 (Resonant Triangle) +12st +7 cents
v22 w0 N12,7 a-4.0 p-.20 c 7 0.25 ct .002,.80,.15,.60 cd 0.85 t.002,1.0,.20,.75 ds 0.45
[CZ Reso-Tri Shimmer] vt

# ======================================================================
# STYLE 7: KORG DW-8000 2-OSC DIGI-BASS & ROTARY ORGAN (Voices 24..25, 28..29)
# ======================================================================
# Strictly 2 DWGS digital oscillators per voice into NJM2069 analog 24dB VCF
# DW Digi Bass (Voices 24 & 25):
# Osc 1 (Voice 24): DWGS Digital Bass (w28), punchy slap transient, dry (ds 0)
# Slaves Voice 25 via G25 H25
v24 w28 r 2 ds 0 a-3.5 p0 t.002,.24,.45,.08 j1,1 k280 q2.4 jd 2.0 kt.002,.24,.15,.06 kd2400
v24 G25 H25
[DW8000 Digi Bass Osc1] vt

# Osc 2 (Voice 25): DWGS Electric Bass (w27) detuned +5 cents (N0,5) for bottom weight
v25 w27 r 2 ds 0 N0,5 a-4.0 p0 t.002,.24,.45,.08 j1,1 k300 q2.4 jd 2.0 kt.002,.24,.15,.06 kd2400
[DW8000 Digi Bass Osc2] vt

# DW Rotary Organ (Voices 28 & 29):
# Wide open NJM2069 VCF (k4500 q0.7) lets all drawbar harmonics cut through!
# High sustained drawbar body (sustain .88) and warm acoustic room/Leslie decay (release .45)
# Osc 1 (Voice 28): DWGS Organ (w21), high sustained drawbar body, rich delay send (ds 0.30)
v28 w21 r 2 ds 0.30 a-3.2 p-.25 t.008,.30,.88,.45 j1,1 k4500 q0.7
v28 G29 H29
[DW8000 Rotary Organ Osc1] vt

# Osc 2 (Voice 29): DWGS Organ (w21) detuned +8 cents (N0,8) for lush Leslie rotary beating
v29 w21 r 2 ds 0.30 N0,8 a-3.7 p.25 t.008,.30,.88,.45 j1,1 k4500 q0.7
[DW8000 Rotary Organ Osc2] vt

# ======================================================================
# STYLE 8: KORG DW-8000 2-OSC POWER BRASS & COSMIC BELLS (Voices 26..27, 30..31)
# ======================================================================
# DW 80s Power Brass (Voices 26 & 27):
# Osc 1 (Voice 26): DWGS Brass (w22) through sweeping NJM2069 lowpass
v26 w22 r 2 ds 0.25 a-4.2 p-.20 t.015,.35,.75,.20 j1,1 k420 q2.0 jd 1.5 kt.025,.40,.55,.18 kd3400
v26 G27 H27
[DW8000 Power Brass Osc1] vt

# Osc 2 (Voice 27): DWGS Brass (w22) twin horn detuned +8 cents (N0,8) for massive analog spread
v27 w22 r 2 ds 0.25 N0,8 a-5.2 p.20 t.015,.35,.75,.20 j1,1 k450 q2.0 jd 1.5 kt.025,.40,.55,.18 kd3400
[DW8000 Epiano Bite Osc2] vt

# DW Cosmic Bells (Voices 30 & 31):
# Deep, shimmering crystalline bells with extended celestial sustain (.40) and long chime release (.75)
# Osc 1 (Voice 30): DWGS Bell (w29) through crisp NJM2069 VCF, slaving v31
v30 w29 r 2 ds 0.40 a-3.8 p-.25 t.002,1.0,.40,.75 j1,1 k3200 q3.0 kt.002,.80,.25,.40 kd2800
v30 G31 H31
[DW8000 Cosmic Bell Osc1] vt

# Osc 2 (Voice 31): DWGS Bell (w29) tuned +12st +6 cents (N12,6) for sparkling octave chime
v31 w29 r 2 ds 0.40 N12,6 a-4.8 p.25 t.002,1.0,.40,.75 j1,1 k3400 q3.0 kt.002,.80,.25,.40 kd2800
[DW8000 Cosmic Bell Osc2] vt

# ======================================================================
# STYLE 9: COMMODORE 64 MOS 6581 SID CHIPTUNE (Voices 32..34)
# ======================================================================
# Features:
#   - MOS 6581 non-linear DAC bit-crush (bc 8,2)
#   - Authentic 23-bit SID LFSR hardware noise generator (w5 NT 0) with percussive envelope
#   - Fast PWM arpeggiator and 8-bit DAC triangle bass
# Voice 32 (SID Arpeggio Pulse Lead): Fast PWM with SID non-linear DAC curve
v32 w1 pw 0.35 bc 8,2 pwt .01,.20,.20,.05 pwd 0.20 a-3.5 p-.15 t.001,.16,0,.04 g0.015
[C64 SID Arp Pulse] vt

# Voice 33 (MOS 6581 23-bit SID LFSR Noise): Authentic punchy hardware noise hit
v33 w5 NT 0 bc 8,2 a-5.0 p.15 t.001,.38,0,.08
[C64 SID LFSR Noise] vt

# Voice 34 (SID Triangle Bass): PolyBLEP Triangle through 6581 DAC curve
v34 w4 bc 8,2 a-3.5 p0 t.002,.22,0,.04
[C64 SID Tri Bass] vt

# ======================================================================
# STYLE 10: ATARI POKEY & NES RETRO ARCADE CHIPTUNE (Voices 35..38)
# ======================================================================
# Features:
#   - Atari POKEY 4-bit metallic buzzing noise generator (w5 NT 1) with percussive envelope
#   - NES 15-bit periodic white noise generator (w5 NT 5) with percussive snare decay
#   - NES 25% duty cycle pulse lead and 4-bit stepped triangle bass (bc 4,0)
# Voice 35 (NES 25% Pulse Lead): Characteristic NES arcade chiptune timbre
v35 w1 pw 0.25 a-3.5 p-.20 t.001,.14,0,.03 g0.010
[NES 25% Pulse Lead] vt

# Voice 36 (Atari POKEY 4-bit Metallic Noise): Bold 15-step metallic buzzing hit
v36 w5 NT 1 a-5.0 p.20 t.001,.35,0,.08
[POKEY 4-bit Noise] vt

# Voice 37 (NES 15-bit Periodic Noise Snare): Authentic 32767-step NES snare hit
v37 w5 NT 5 a-5.0 p-.20 t.001,.40,0,.08
[NES 15-bit Noise] vt

# Voice 38 (NES Stepped 4-bit Triangle Bass): Authentic 4-bit DAC stair-step bass
v38 w4 bc 4,0 a-3.5 p0 t.002,.18,0,.03
[NES 4-bit Tri Bass] vt

