[
  # Bar 1: Heroic 1985 DWGS analog brass anthem (held sustaining horns)
  G3 - - -  B3 - - -  D4 - - -  - - - -

  # Bar 2: Soaring brass swell into turnaround
  E4 - - -  - - - -  D4 - - -  B3 - - -

  # Bar 3: Punchy syncopated brass anthem
  G3 - - -  C4 - - -  D4 - - -  - - - -

  # Bar 4: Triumphant brass resolution
  E4 - - -  D4 - - -  B3 - - -  G3 - - -
] n>d /SS 7

# Stream 17: Korg DW-8000 Cosmic Bells (Glistening digital bell echoes, 64 steps)
[
  # Bar 1: High crystalline bell shimmer with sparkling sustain
  . . . .  B5 - - -  . . . .  E6 - - -

  # Bar 2: Bell echo cascades
  . . . .  D6 - - -  . . . .  B5 - - -

  # Bar 3: Harmonized bell answer
  . . . .  G5 - - -  . . . .  E5 - - -

  # Bar 4: Cascading turnaround
  D5 - - -  B4 - - -  G4 - - -  E4 - - -
] n>d /SS 17

# Stream 8: Commodore 64 MOS 6581 SID Fast Arpeggio Lead (D Minor, 64 steps)
# Rob Hubbard / Martin Galway style rapid-fire chiptune arpeggio
[
  # Bar 1: High-velocity SID pulse arp (Dm)
  D3 A3 D4 F4  A4 F4 D4 A3  D3 A3 D4 F4  A4 F4 D4 A3

  # Bar 2: Classic C64 chromatic turnaround (Bb -> C)
  Bb2 F3 Bb3 D4  F4 D4 Bb3 F3  C3 G3 C4 E4  G4 E4 C4 G3

  # Bar 3: Driving demoscene syncopation
  D3 A3 D4 F4  A4 F4 D4 A3  F3 C4 F4 A4  C5 A4 F4 C4

  # Bar 4: Screaming SID turnaround
  G3 D4 G4 Bb4  A3 E4 A4 C5  D4 A4 D5 F5  D5 A4 F4 -
] n>d /SS 8

# Stream 18: Commodore 64 MOS 6581 SID Triangle Bass (D Minor, 64 steps)
[
  # Bar 1: Punchy 8-bit DAC triangle bass
  D2 . D2 .  D2 . F2 .  G2 . A2 .  D2 . C2 .

  # Bar 2: C64 bass bounce (Bb -> C)
  Bb1 . Bb1 .  Bb1 . D2 .  C2 . C2 .  E2 . G2 .

  # Bar 3: Relentless driving rhythm
  D2 . D2 .  D2 . F2 .  F2 . F2 .  A2 . C3 .

  # Bar 4: Fast octave turnaround
  G2 . G2 .  A2 . A2 .  D2 - - -  D2 - - -
] n>d /SS 18

# Stream 9: Atari POKEY & NES Retro Arcade Lead (A Minor, 64 steps)
# Mega Man / Castlevania 8-bit platformer action drive (No hanging ties)
[
  # Bar 1: Punchy NES 25% duty pulse lead (Am)
  A3 . A3 .  C4 . D4 .  E4 . G4 .  E4 D4 C4 .

  # Bar 2: Driving 8-bit arcade bounce
  A3 . A3 .  C4 . D4 .  E4 G4 A4 .  B4 . A4 G4

  # Bar 3: Heroic action sequence
  F3 . F3 .  A3 . C4 .  G3 . G3 .  B3 . D4 .

  # Bar 4: Clean staccato turnaround
  E3 . E4 .  F4 . E4 .  D4 . C4 .  A3 - - -
] n>d /SS 9

# Stream 19: Atari POKEY & NES Retro Arcade Triangle Bass (A Minor, 64 steps)
[
  # Bar 1: 4-bit stepped triangle bass bounce
  A2 . A2 .  A2 . C3 .  D3 . D3 .  E3 . G2 .

  # Bar 2: Driving arcade bassline
  A2 . A2 .  A2 . C3 .  E3 . E3 .  G3 . E3 .

  # Bar 3: Heroic low action drive
  F2 . F2 .  F2 . A2 .  G2 . G2 .  G2 . B2 .

  # Bar 4: Tight staccato turnaround
  E2 . E3 .  F2 . F3 .  D2 . D3 .  A2 - - -
] n>d /SS 19

