# ----------------------------------------------------------------------
# 6. CONTROL PLANE DISPATCHER & REAL-TIME CLI CONSOLE BANNERS
# ----------------------------------------------------------------------
# Start the background control event dispatch thread
/cer 1

# Disable master pattern sync locking so 4-bar scenes advance smoothly
yp -1

# Responder macros triggered by control plane events (ce0..ce9) on scene start
[scene_moog_puts]    : [>>> SCENE 0: MINIMOOG MODEL D (3-Osc Fat Analog Bass + Driven Ladder Filter) <<<] puts ;
[scene_prophet_puts] : [>>> SCENE 1: SEQUENTIAL PROPHET-5 (Talking Heads Warm Bouncy Lead + Curtis CEM3320) <<<] puts ;
[scene_korg_puts]    : [>>> SCENE 2: EARLY KORG MS-20 (Dual VCO Screamer 35 Filter & Hot Analog Drive) <<<] puts ;
[scene_jupiter_puts] : [>>> SCENE 3: ROLAND JUPITER-8 (Lush Stereo Arpeggio + Space Delay) <<<] puts ;
[scene_cz_puts]      : [>>> SCENE 4: CASIO CZ-101 (Phase Distortion Digi-Bass & Brass Stabs) <<<] puts ;
[scene_cz_bell_puts] : [>>> SCENE 5: CASIO CZ-101 (Glassy Phase Distortion Bells & Space Harp) <<<] puts ;
[scene_dw_space_puts] : [>>> SCENE 6: KORG DW-8000 (2-Osc Digi-Bass & Rotary Organ + Modulated DW Delay) <<<] puts ;
[scene_dw_brass_puts] : [>>> SCENE 7: KORG DW-8000 (2-Osc 80s Power Brass & Cosmic Bells) <<<] puts ;
[scene_sid_puts]     : [>>> SCENE 8: COMMODORE 64 MOS 6581 SID (23-Bit Hardware LFSR Noise + Non-Linear DAC Arp) <<<] puts ;
[scene_arcade_puts]  : [>>> SCENE 9: ATARI POKEY & NINTENDO NES (4-Bit Metallic Noise + 25% Pulse + Stepped Tri) <<<] puts ;

# Bind responders to user control event IDs 0..9
[scene_moog_puts]     /ceb 4 0
[scene_prophet_puts]  /ceb 4 1
[scene_korg_puts]     /ceb 4 2
[scene_jupiter_puts]  /ceb 4 3
[scene_cz_puts]       /ceb 4 4
[scene_cz_bell_puts]  /ceb 4 5
[scene_dw_space_puts] /ceb 4 6
[scene_dw_brass_puts] /ceb 4 7
[scene_sid_puts]      /ceb 4 8
[scene_arcade_puts]   /ceb 4 9

# ----------------------------------------------------------------------
# 7. SCENE DEFINITIONS & AUTOMATED PROGRESSION
# Lanes:
#   Lane 0: Lead / Main Synth (y0 / y10 / y20 / y30 / y40 / y50 / y60 / y70 / y80 / y90)
#   Lane 1: Bass / Kick / Aux (y1 / y11 / y21 / y31 / y41 / y51 / y61 / y71 / y82 / y93)
#   Lane 2: Hats / Snare / Perc (y2 / y12 / y22 / y32 / y42 / y52 / y62 / y72 / y81 / y91)
#   Lane 3: Aux Percussion (y92)
#   Lane 7: Master Conductor Pattern (y124..y133)
# ----------------------------------------------------------------------

# Scene 0: Minimoog Model D 3-Oscillator Analog Bass Showcase
( 0  1  2 -1 -1 -1 -1 124 ) scene_define 0

# Scene 1: Sequential Prophet-5 Talking Heads Warm Bouncy Lead
( 10 11 12 -1 -1 -1 -1 125 ) scene_define 1

# Scene 2: Early Korg MS-20 Dual VCO Screamer Filter & Drive
( 20 21 22 -1 -1 -1 -1 126 ) scene_define 2

# Scene 3: Roland Jupiter-8 Stereo Dual-Osc Arpeggiator & Delay
( 30 31 32 -1 -1 -1 -1 127 ) scene_define 3

# Scene 4: Casio CZ-101 Phase Distortion Digi-Bass & Brass Stabs
( 40 41 42 -1 -1 -1 -1 128 ) scene_define 4

# Scene 5: Casio CZ-101 Glassy Phase Distortion Bells & Space Harp
( 50 51 52 -1 -1 -1 -1 129 ) scene_define 5

# Scene 6: Korg DW-8000 2-Osc Digi-Bass & Rotary Organ + Modulated Delay
( 60 61 62 -1 -1 -1 -1 130 ) scene_define 6

# Scene 7: Korg DW-8000 2-Osc Hybrid Power Brass & Cosmic Bells
( 70 71 72 -1 -1 -1 -1 131 ) scene_define 7

# Scene 8: Commodore 64 MOS 6581 SID Fast PWM Arp + Hardware LFSR Noise
( 80 82 81 -1 -1 -1 -1 132 ) scene_define 8

# Scene 9: Atari POKEY & Nintendo NES Retro Arcade Chiptune
( 90 93 91 92 -1 -1 -1 133 ) scene_define 9

# Automated 4-bar scene progression cycle across all 10 synthesizer scenes:
0 4 1 scene_chain
1 4 2 scene_chain
2 4 3 scene_chain
3 4 4 scene_chain
4 4 5 scene_chain
5 4 6 scene_chain
6 4 7 scene_chain
7 4 8 scene_chain
8 4 9 scene_chain
9 4 0 scene_chain

# ----------------------------------------------------------------------
# 8. PERFORMANCE MACROS & REALTIME PARAMETER TWEAKS
# ----------------------------------------------------------------------
# Filter & Drive Tweaks
[filter_open]   : v0 k280 kd3200 v1 k300 kd3000 v4 k650 kd3500 v7 k650 kd3800 v12 k1200 kd4500 [Filter: Wide Open] puts ;
[filter_deep]   : v0 k80 kd1100 v1 k90 kd1000 v4 k200 kd1600 v7 k220 kd1800 v12 k450 kd2200 [Filter: Deep Sub] puts ;
[filter_normal] : v0 k115 kd1850 v1 k125 kd1700 v4 k380 kd2200 v7 k350 kd3200 v12 k650 kd3400 [Filter: Standard Punch] puts ;
[res_high]      : v0 q6.2 v1 q5.8 v4 q4.5 v7 q7.5 v12 q4.5 [Resonance: High Peak] puts ;
[drive_hot]     : v0 jd 4.5 v1 jd 4.5 v4 jd 2.5 v7 jd 5.5 [Filter Drive: Hot Saturation] puts ;

# Glissando / Portamento Tweaks
[glide_long] : v0 g0.12 v1 g0.12 v2 g0.12 v4 g0.09 v7 g0.09 [Glide: Long Slinky] puts ;

# Synth-Specific Character Tweaks
[prophet_warm]   : v4 k380 kd2200 v5 N0,5 v6 a0.12 [Prophet-5: Talking Heads Warm Bouncy Lead] puts ;
[prophet_bright] : v4 k750 kd3200 v5 N0,8 v6 a0.15 [Prophet-5: Bright Punchy Lead] puts ;
[korg_screech]   : v7 q7.8 jd 5.0 v8 q7.2 jd 4.5 [Korg MS20 Screaming Self-Oscillation] puts ;
[korg_punch]     : v7 q5.8 jd 3.5 v8 q5.2 jd 3.0 [Korg MS20 Aggressive Industrial Punch] puts ;

# Casio CZ Phase Distortion Tweaks
[cz_bright]   : v15 cd 0.95 v16 cd 0.95 v17 cd 0.85 v21 cd 0.90 [Casio CZ: Max DCW Brightness] puts ;
[cz_resonant] : v16 c 6 0.15 cd 0.95 v15 c 6 0.20 cd 0.90 [Casio CZ: High Resonance Scream] puts ;
[cz_mellow]   : v15 cd 0.40 v16 cd 0.35 v17 cd 0.30 v21 cd 0.45 [Casio CZ: Smooth Warm DCW] puts ;

# Korg DW-8000 Tweaks
[dw_delay_mod]   : DL 2 5 8 8 16 24 7 [DW-8000: Swirling Modulated Delay] puts ;
[dw_delay_tight] : DL 2 3 4 4 0 0 5 [DW-8000: Tight Slapback Delay] puts ;
[dw_filter_warm] : v24 k480 kd2400 v26 k420 kd2200 [DW-8000: NJM2069 Warm Resonance] puts ;

# Chiptune LFSR & DAC Hardware Tweaks
[nt_sid]        : v33 NT 0 v36 NT 0 v37 NT 0 [LFSR Noise: MOS 6581 SID 23-bit Hardware Preset] puts ;
[nt_pokey_buzz] : v33 NT 1 v36 NT 1 v37 NT 1 [LFSR Noise: Atari POKEY 4-bit Metallic Buzz] puts ;
[nt_nes_white]  : v33 NT 5 v36 NT 5 v37 NT 5 [LFSR Noise: NES 15-bit Periodic White Noise] puts ;
[sid_dac_on]    : v32 bc 8,2 v34 bc 8,2 [SID MOS 6581 Non-Linear DAC: Enabled] puts ;
[sid_dac_off]   : v32 bc 0 v34 bc 0 [SID Non-Linear DAC: Clean Linear Bypass] puts ;
[nes_tri_step]  : v38 bc 4,0 [NES Triangle: 4-bit Quantized Stair-Steps] puts ;
[nes_tri_smooth]: v38 bc 0 [NES Triangle: Smooth PolyBLEP Linear] puts ;

# Drum Pocket Mute / Solo
[drums_off] : v9 m1 v10 m1 v11 m1 [Pocket Drums: Muted (Pure Synth Solo)] puts ;
[drums_on]  : v9 m0 v10 m0 v11 m0 [Pocket Drums: Enabled] puts ;

# User Navigation & Scene Cues (Quantized to next bar downbeat)
[scene_moog_bass] : 0 scene_cue ;
[scene_prophet]   : 1 scene_cue ;
[scene_korg]      : 2 scene_cue ;
[scene_jupiter]   : 3 scene_cue ;
[scene_cz_bass]   : 4 scene_cue ;
[scene_cz_bell]   : 5 scene_cue ;
[scene_dw_space]  : 6 scene_cue ;
[scene_dw_brass]  : 7 scene_cue ;
[scene_sid]       : 8 scene_cue ;
[scene_arcade]    : 9 scene_cue ;

# Immediate Scene Jumps (Jump right now without waiting)
[now_moog]     : 0 scene_now ;
[now_prophet]  : 1 scene_now ;
[now_korg]     : 2 scene_now ;
[now_jupiter]  : 3 scene_now ;
[now_cz_bass]  : 4 scene_now ;
[now_cz_bell]  : 5 scene_now ;
[now_dw_space] : 6 scene_now ;
[now_dw_brass] : 7 scene_now ;
[now_sid]      : 8 scene_now ;
[now_arcade]   : 9 scene_now ;

# Transport Controls
[play]     : Z0 Z! scene_now 0 ;
[pause]    : scene_pause ;
[resume]   : scene_resume ;
[scenes]   : [SCENES: 0:moog 1:prophet 2:korg_ms20 3:jupiter8 4:cz_bass 5:cz_bell 6:dw_space 7:dw_brass 8:sid_c64 9:arcade_nes] puts ;
[controls] : [LIVE TWEAKS: filter_open, filter_deep, res_high, drive_hot, glide_long, prophet_warm, prophet_bright, korg_screech, korg_punch, cz_bright, cz_resonant, cz_mellow, dw_delay_mod, dw_delay_tight, nt_sid, nt_pokey_buzz, nt_nes_white, sid_dac_on, sid_dac_off, nes_tri_step, drums_off, drums_on] puts ;

