# ----------------------------------------------------------------------
# 9. CONDUCTOR (Pattern 0: 1 step per bar, 80 bars)
# ----------------------------------------------------------------------
y0
[conductor] yt
%16

# --- INTRO: Machine Boot, Metal Clang & LFSR Glitch (Bars 0-7: 8 bars) ---
# Bar 0: Metallic anvil + cowbell + closed hats + NES glitch ticks + dark pad
[y8 z1 y10 z1 y3 z1 y11 z1 v3 a-99] x0
[=126,1] x1
[=126,2] x2
[=126,3] x3

# Bar 4: The KMFDM Chug enters naked with open hats!
[/SP 1 0 y4 z1 v3 a-2] x4
[=126,5] x5
[=126,6] x6
# Bar 7: Noise riser sweep + machine-gun ratchet snare roll!
[v16 l1 y13 z1] x7

