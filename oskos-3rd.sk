y10
[metal anvil] yt
[v18 l1 v12 l.9] x4,12
[v18 l.6] x14
[=127,0] x15

# Pattern 11: Polyphonic Dark Pad Swells (4 bars, 64 steps: Dm -> Bb -> Gm -> A)
y11
[cyber pad] yt
[pn 0,101,50,.75 pn 0,102,53,.75 pn 0,103,57,.75] x0       # Dm
[pr 0,101 pr 0,102 pr 0,103] x15
[pn 0,104,46,.75 pn 0,105,50,.75 pn 0,106,53,.75] x16      # Bb
[pr 0,104 pr 0,105 pr 0,106] x31
[pn 0,107,43,.75 pn 0,108,46,.75 pn 0,109,50,.75] x32      # Gm
[pr 0,107 pr 0,108 pr 0,109] x47
[pn 0,110,45,.75 pn 0,111,49,.75 pn 0,112,52,.75] x48      # A
[pr 0,110 pr 0,111 pr 0,112] x63
[=127,0] x63

# Pattern 13: Machine-Gun Ratchet Snare Roll (1 bar, 16 steps)
y13
[snare roll] yt
[v1 l0.3 v4 l.7 v17 l.5] x0,4,8,12
[v1 l0.5 v17 l.6] x2,6,10,14
[v1 l0.7 v17 l.8 z*2] x8,10
[v1 l0.85 v17 l.9 z*4] x12,13,14
[v1 l1.0 v17 l1.0 z*8] x15
[-] x16

