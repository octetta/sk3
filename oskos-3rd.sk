# ======================================================================
#  OSKOS 3RD (Heavy Industrial Techno / Cyber-Grind Showcase)
#  Showcase Piece for sk3 & Skode v1.3.13
#  138 BPM, D minor, Heavy Industrial Stomp & Hard-Sync Machine
#  Inspired by KMFDM, 808 State, and Berghain Industrial Techno
# ======================================================================

[OSKOS 3RD - INDUSTRIAL CYBER-STOMP (sk3 SHOWCASE)] puts
V -7.2
M 138 16

# ----------------------------------------------------------------------
# 1. TEMPO-SYNCED DELAY BUSES (138 BPM)
# ----------------------------------------------------------------------
# Bus 1: 16th industrial slapback
DS 1 138 .25
DL 1 - - 6 0 0 9
DD 1 5 4

# Bus 2: Eighth-note ping-pong stereo echo (Equal-Power Panned)
DS 2 138 .5
DL 2 - - 7 0 0 10
DD 2 6 4
DP 2 1

# Bus 3: Dotted-eighth metallic echo
DS 3 138 .75
DL 3 - - 8 3 3 11
DD 3 7 3

# Bus 4: Heavy industrial hall wash (Equal-Power Panned)
DS 4 138 1.0
DL 4 - - 11 4 8 10
DD 4 8 2
DP 4 1

# ----------------------------------------------------------------------
# 2. IN-LINE K-SYNTH PROCEDURAL GENERATOR (Noise Riser Wavetable)
# ----------------------------------------------------------------------
[
/ industrial noise riser
N: 131072
T: !N
E: (e(T*(4.5%N)))%100
R: r T
L: 0.35 f R
H: R-L
F: 950*(e(T*(2.8%N)))*((p 2)%(p 0))
P: +\F
S: s P
W: w E*((S*.35)+(H*.65))
] k!
k>w301,44100,1
v16 w301 f190 a8 p0 t.005,.01,1,.3 r4 ds.3  # noise riser sweep

# ----------------------------------------------------------------------
# 3. DRUM VOICES & INDUSTRIAL PERCUSSION
# ----------------------------------------------------------------------
# 808 Kick: Punch transient + Pitch-diving Sub Boom
v0 w82 f440 a5 p0                           # 808 kick punch
v5 w0 a-2.5 p0 t.002,.32,0,.10 j1 k160 q.7  # 808 sub boom (pitch dive)

# Snares, Claps & Percussion
v1 w83 f440 a5.5 r2 p0 ds.25                # industrial snare
v4 w86 f440 a5 r2 p0 ds.3                   # 808 clap
v21 w94 f440 a3 p.2                         # crash cymbal
v22 w96 f440 a3.5 p-.25 r2 ds.3             # 808 cowbell (808 State signature!)
v23 w87 f440 a5 p.3                         # rim tick / anvil edge

# Retro Hardware LFSR Noise (w5 + NT)
v2 w84 f440 a-3 p.25                        # 808 closed hat
v3 w85 f440 a-2 p-.25                       # 808 open hat
v17 w5 NT 5 a-6.5 p-.35 f1800 t.001,.10,0,.03 r2 ds.25 # NES 15-bit LFSR snare crack layer
v25 w5 NT 6 a-7.5 p.4 f2600 t.001,.03,0,.01             # NES 7-bit LFSR glitch tick accent

# Industrial Metal Clang (Ring Mod of inharmonic oscillators)
v18 w16 f415 a-3 t.001,.30,0,.15 bc6 r2 p0 ds.35 XM19 H19
v19 w15 f261 a0 m1

# FM Feedback Metal Strike (Heavy Industrial Anvil Hit)
v11 w0 a-2 p-.3 t.001,.35,0,.2 FF2 FB6 F12,2.8 G12 H12 r2 ds.3
v12 w0 a0 t.001,.25,0,.2 N26 m1

# ----------------------------------------------------------------------
# 4. HARD SYNC MONSTER LEAD (Master-Slave Oscillator Hard-Sync)
# ----------------------------------------------------------------------
# Voice 13: Master Fundamental Oscillator
# Voice 14: Slave Oscillator 1 (Octave + 12 cents, Hard-Synced via HS)
# Voice 15: Slave Oscillator 2 (Octave + Fifth - 8 cents, Hard-Synced via HS)
v13 w15 a-8 p-.3 t.004,.22,.4,.10 j1,1 k5200 q2.0 r1 ds.4
v14 w15 a-9.5 p.3 N12,12 t.004,.22,.4,.10 j1,1 k5800 q2.5 r1 ds.4
v15 w16 a-9.5 p.6 N19,-8 t.004,.22,.4,.10 j1,1 k5400 q2.0 r1 ds.4
v13 HS 14 15                                # Hard-Sync Master -> Slaves 14 and 15
v13 G14,15 H14,15                           # Gate & Velocity links

# LEAD 2: 808 State Parallel Rave Stabs (Detuned Saw 5ths)
v9 w15 a-6 p-.2 t.002,.20,0,.08 j1,1 k3800 q2.2 r2 ds.3 G20 H20
v20 w15 a-8 p.2 N7 m0

# ----------------------------------------------------------------------
# 5. INDUSTRIAL BASSES
# ----------------------------------------------------------------------
# BASS 1: KMFDM Industrial Guitar/Synth Chug (Detuned Moog Saw + Pulse Octave)
v6 w15 a-2 p0 t.002,.15,0,.04 j1,1 k650 q4.5 ft.001,.13,0,.03 fd2800 c4,.45
v6 >7
v7 w16 a-4 N12,9 p0
v6 G7 H7

# BASS 2: 303 Acid Screamer (High-Q Gliding Saw with Portamento)
v8 w15 a-3 t.002,.18,0,.05 j1,2 k400 q9.0 ft.001,.16,0,.05 fd3200 g.035 r2 p0 ds.35

# BASS 3: Sub-Bass Reinforcer (Drops & Climax)
v10 w0 a-1 p0 t.002,.25,.2,.08 j1 k250 q1.5

# ----------------------------------------------------------------------
# 6. POLYPHONIC INDUSTRIAL PAD POOL (Cold Cyber-Strings)
# ----------------------------------------------------------------------
v24 w0 f.32 a0 t0,0,1,0 m1
v26 w15 a-10 p-.5 t1.0,.4,.7,1.2 j1 k2400 q.8 c4,.2 C24,.2 G27 H27
v27 w15 a-12 p.5 N0,9 t1.0,.4,.7,1.2 j1 k2400 q.8 c4,.2 C24,.2
/pg 0,26,2,0
/pp 0,0,28,5,0
v24 l1

# ----------------------------------------------------------------------
# 7. STREAMS (Notes via n>d)
# ----------------------------------------------------------------------

# Stream 1: KMFDM Industrial Metal Chug (16 steps = 1 bar in D minor)
# D1 D1 . D1  F1 - D1 -  Ab1 - G1 -  D1 - F1 -
[ D1 D1 . D1  F1 - D1 -  Ab1 - G1 -  D1 - F1 - ] n>d /SS 1

# Stream 2: 808 State "Cubik" Rave-Industrial Stabs (32 steps = 2 bars)
[
  D2 D2 F2 D2  - G2 - Ab2  F2 - D2 -  C2 - D2 -
  D2 D2 F2 D2  - G2 - C3   B2 - Ab2 - G2 - F2 -
] n>d /SS 2

# Stream 3: KMFDM Relentless 16th Sequencer Ostinato (32 steps = 2 bars)
[
  D2 D2 D3 D2  F2 D2 Ab2 G2  D2 D2 D3 D2  C3 B2 A2 F2
  D2 D2 D3 D2  F2 D2 Ab2 G2  D2 D2 D3 D2  F3 E3 D3 C3
] n>d /SS 3

# Stream 4: Industrial Hard-Sync Siren Lead Hook (64 steps = 4 bars)
[
  D5 - - -  Ab5 - G5 -  F5 - D5 -  C5 - D5 -
  D5 - - -  Ab5 - G5 -  F5 - - -  E5 - - -
  D5 - - -  Ab5 - G5 -  F5 - D5 -  F5 - G5 -
  Ab5 - - - G5 - - -  F5 - E5 -  D5 - C5 -
] n>d /SS 4
/SC 4 4

# Stream 5: 303 Acid Screamer Riff (with Portamento Slides) (32 steps = 2 bars)
[
  D2 . ~F2 .  ~G2 . ~Ab2 .  ~G2 . ~F2 .  ~D2 . ~C2 .
  D2 . ~F2 .  ~G2 . ~C3 .   ~B2 . ~Ab2 . ~G2 . ~F2 .
] n>d /SS 5

# Stream 6: Dark Cyber Pad Chords (4 bars: Dm -> Bb -> Gm -> A)
[
  D3 . . .  . . . .  . . . .  . . . .
  Bb2 . . . . . . .  . . . .  . . . .
  G2 . . .  . . . .  . . . .  . . . .
  A2 . . .  . . . .  . . . .  . . . .
] n>d /SS 6

# Stream 14: High Hard-Sync Screamer Climax (64 steps = 4 bars)
[
  D6 - - -  Ab6 - G6 -  F6 - D6 -  C6 - D6 -
  D6 - - -  Ab6 - G6 -  F6 - - -  E6 - - -
  D6 - - -  Ab6 - G6 -  F6 - D6 -  F6 - G6 -
  Ab6 - - - G6 - - -  F6 - E6 -  D6 - C6 -
] n>d /SS 14

