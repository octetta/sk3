# ======================================================================
#  GEN-DRUM-DEMO: 70's & 80's ANALOG DRUM MACHINE PRESET COLLECTION
#  Procedural Physical Modeling Drum Synthesis & Arranger Showcase
#  ======================================================================
#  Synthesizes a complete vintage analog percussion collection using the
#  sk3 procedural physical modeling engine ('gen!') and demonstrates
#  authentic preset rhythms from classic hardware drum machines:
#
#    1. Roland CR-78 CompuRhythm (1978) - Bossa Nova & Cha-Cha
#    2. 1970s Space Disco (1977-1979)   - Moroder Four-on-the-Floor
#    3. Roland TR-808 (1980-1982)       - "Planet Rock" Electro Hip-Hop
#    4. Latin Electro Freestyle (1983)   - Shannon "Let The Music Play"
#    5. 1980s Synth-Pop (1983-1985)     - Gated Snare & Ride Cymbal Ping
#    6. Simmons SDS-V Electronic (1981) - Pitch-Diving Disco Toms & Lasers
#    7. D.C. Go-Go & Boogie Funk (1985)  - Syncopated Cowbell & Congas
#    8. All-Star Analog Climax           - Full Vintage Hardware Jam
#
#  Features:
#    - 18 procedurally generated drum instruments (wavetables 100..117)
#    - 18 fully labeled stereo voices (v0..v17 with custom panning)
#    - 8-stage automated scene progression via the Scene Arranger matrix
#    - Interactive scene cues and performance macro effects
# ======================================================================

[===============================================================] puts
[  70'S & 80'S ANALOG DRUM MACHINE COLLECTION (PROCEDURAL GEN!) ] puts
[===============================================================] puts

# Global Master Output: -2.5 dB headroom for clean multi-voice mix
V -2.5

# Master Tempo: 124 BPM, 16 steps per measure
M 124 16

# ----------------------------------------------------------------------
# 1. PROCEDURAL PHYSICAL MODELING DRUM SYNTHESIS ([drum:...] gen!)
# Synthesizes analog circuits directly into wavetable slots 100..117
# ----------------------------------------------------------------------

# Slot 100: TR-808 Sub Boom Kick (Deep pitch drop with sustained 40 Hz sub tail)
[drum:kick p:130 end:40 d:0.75 pdecay:0.045 c:0.25 drive:1.2] 100 gen!
[808 Sub Kick] wt 100

# Slot 101: TR-909 Punch Club Kick (Punchy beater attack with cubic drive)
[drum:kick p:165 end:48 d:0.38 pdecay:0.030 c:0.45 drive:2.0] 101 gen!
[909 Punch Kick] wt 101

# Slot 102: TR-808 Resonant Snare (Dual body modes 180/230 Hz + bandpassed wire snap)
[drum:snare f1:180 f2:230 snap:0.75 d:0.08 tail:0.22 f:2800] 102 gen!
[808 Snare] wt 102

# Slot 103: TR-808 Resonant Rimshot (Twin-T high-Q 1750 Hz resonator + stick click)
[drum:rim f:1750 d:0.038 click:0.55] 103 gen!
[808 Rimshot] wt 103

# Slot 104: TR-808 Stereo Handclap (Triple transient pre-burst + diffuse reverb tail)
[drum:clap bursts:3 spread:11 tail:0.24 f:1100] 104 gen!
[808 Handclap] wt 104

# Slot 105: TR-808 Closed Hi-Hat (6-oscillator inharmonic metallic square cluster)
[drum:hat open:0 d:0.045] 105 gen!
[808 Closed Hat] wt 105

# Slot 106: TR-808 Open Hi-Hat (Sustained metallic sizzle with natural ring)
[drum:hat open:1 d:0.45] 106 gen!
[808 Open Hat] wt 106

# Slot 107: TR-808 Low Tom (Resonant membrane with 45ms pitch drop)
[drum:tom n38 d:0.36 pdecay:0.045 drop:0.45] 107 gen!
[808 Low Tom] wt 107

# Slot 108: TR-808 High Tom (Tuned rack tom with snappy attack)
[drum:tom n50 d:0.24 pdecay:0.038 drop:0.35] 108 gen!
[808 High Tom] wt 108

# Slot 109: TR-808 Low Conga (Warm resonant sine modes with skin tension relaxation)
[drum:conga pitch:low d:0.28 drop:0.28 slap:0.30] 109 gen!
[808 Low Conga] wt 109

# Slot 110: TR-808 High Conga (Cutting high conga with sharp hand slap skin transient)
[drum:conga pitch:high d:0.18 drop:0.22 slap:0.55] 110 gen!
[808 High Conga] wt 110

# Slot 111: TR-808 Claves (Bridged-T ringing 2450 Hz resonant circuit, woody tap)
[drum:clave f:2450 d:0.038] 111 gen!
[808 Claves] wt 111

# Slot 112: TR-808 Cowbell (Classic dual square waves 540 Hz & 800 Hz)
[drum:cowbell d:0.18 f1:540 f2:800] 112 gen!
[808 Cowbell] wt 112

# Slot 113: TR-808 Maracas (Shaped bead acceleration attack + 7.5 kHz noise wash)
[drum:maraca f:7500 d:0.045] 113 gen!
[808 Maracas] wt 113

# Slot 114: TR-808 Crash Cymbal (Multi-band low metallic body + high sizzle wash)
[drum:crash d:2.4 tone:0.55 sizzle:0.75] 114 gen!
[808 Crash] wt 114

# Slot 115: Analog Ride Cymbal (Metallic cluster shimmer + tuned 587/845 Hz bell ping)
[drum:ride d:1.8 tone:0.65 ping:0.70] 115 gen!
[Analog Ride] wt 115

# Slot 116: Simmons SDS-V Disco Tom (Iconic 1980s hexagonal tom with quadratic pitch plunge)
[drum:simmons f:580 end:65 d:0.48 pdecay:0.08 noise:0.28 click:0.45] 116 gen!
[Simmons Tom] wt 116

# Slot 117: Space Laser Zap (1970s/80s analog electro laser plunge with saturation)
[drum:zap f:3400 end:45 d:0.085 drive:1.5] 117 gen!
[Space Laser] wt 117

