# ======================================================================
#  RAD DISCO ("I Feel Love" Giorgio Moroder Space-Disco Vibe)
#  126 BPM, C Modal (C -> Eb -> F -> C), PolyBLEP Saw + Pulse PWM Bass
# ======================================================================

[RAD DISCO - "I FEEL LOVE" MORODER DISCO VIBES] puts
V -12.0
M 126 16

# ----------------------------------------------------------------------
# DELAY BUSES (Tempo-synced to 126 BPM)
# ----------------------------------------------------------------------
# Bus 1: The Iconic Moroder 16th Ping-Pong Gallop Delay (Dedicated to Bass & Arp)
DS 1 126 .25
DL 1 - - 5 2 2 8
DD 1 5 3
DP 1 1

# Bus 2: Dotted-Eighth Floating Space Echo for Donna Summer Lead
DS 2 126 .75
DL 2 - - 6 3 3 8
DD 2 6 3
DP 2 1

# ----------------------------------------------------------------------
# SYNTHESIS VOICES
# ----------------------------------------------------------------------
# DRUMS (Clean Munich Disco Kit - No Overdrive, Pristine Headroom)
v0 w82 f440 a-1.5 p0                          # 4-on-the-floor punch kick
v1 w83 f440 a-3.5 p0                          # Crisp disco snare (dry, no bus 1 delay)
v2 w84 f440 a-8.0 p.25                        # Subtle 16th closed hi-hat
v3 w85 f440 a-6.0 p-.25                       # Sizzling offbeat open hi-hat
v4 w86 f440 a-4.0 p0                          # Wide stereo disco clap
v5 w0 a-6.0 p0 t.002,.20,0,.05 j1 k140 q.7    # Sub kick weight (clean sine pitch drop)

# BASS: The Authentic Moroder Moog Modular Bass
# Layer 1 (Voice 6): PolyBLEP Saw (w2) -> 24dB Moog ladder lowpass, punchy pluck
v6 w2 a-4.5 p0 t.002,.11,0,.03 j1,1 k260 q2.2 ft.001,.09,0,.03 fd600 r1 ds.25
v6 >7
# Layer 2 (Voice 7): PolyBLEP Pulse (w1) with active PWM modulation
v7 w1 a-6.5 p0 pw 0.38 pwt .01,.14,.2,.05 pwd 0.15 j1 k280 q1.8 ft.001,.09,0,.03 fd500 r1 ds.20
# Slave Voice 7 trigger and pitch to Voice 6
v6 G7 H7

# SHIMMER ARPEGGIATOR: Roland Jupiter / Odyssey 16th Pulse
v11 w1 a-12.0 p-.35 pw 0.25 t.002,.10,0,.03 j1 k2600 q1.5 r1 ds.25

# LEAD: Soaring "Donna Summer" Anthem Lead Hook
# Dual detuned PolyBLEP saw with smooth attack and space delay
v13 w2 a-8.5 p.1 t.015,.35,.6,.25 j1 k3200 q1.2 r2 ds.35
v13 >14
v14 w2 a-10.5 p-.2 N0,6 r0
v13 G14 H14

# ----------------------------------------------------------------------
# NOTE STREAMS (Using /SS with rest '-', tie '.', and slur '~' options)
# ----------------------------------------------------------------------

# Stream 0: The Hypnotic 4-Bar Octave Bass (C -> Eb -> F -> C, 64 steps)
# Played via i&0 on every 16th step. Rest '-' on step 15 gives rhythmic breath.
[
  # Bar 1: C octave pulse
  C2 C3 C2 C3  C2 C3 C2 C3  C2 C3 C2 C3  C2 C3 C2 -
  # Bar 2: Eb octave pulse
  Eb2 Eb3 Eb2 Eb3  Eb2 Eb3 Eb2 Eb3  Eb2 Eb3 Eb2 Eb3  Eb2 Eb3 Eb2 -
  # Bar 3: F octave pulse
  F2 F3 F2 F3  F2 F3 F2 F3  F2 F3 F2 F3  F2 F3 F2 -
  # Bar 4: C octave return
  C2 C3 C2 C3  C2 C3 C2 C3  C2 C3 C2 C3  C2 C3 C2 -
] n>d /SS 0

# Stream 1: Syncopated Bass Variation with Ties '.' and Rests '-' (64 steps)
# Ties sustain previous pitch without re-triggering attack envelope.
[
  # Bar 1: C syncopated bounce
  C2 C3 . C2  . C3 C2 .  C2 C3 . C2  . C3 C2 -
  # Bar 2: Eb syncopated bounce
  Eb2 Eb3 . Eb2  . Eb3 Eb2 .  Eb2 Eb3 . Eb2  . Eb3 Eb2 -
  # Bar 3: F syncopated bounce
  F2 F3 . F2  . F3 F2 .  F2 F3 . F2  . F3 F2 -
  # Bar 4: C turnaround
  C2 C3 . C2  . C3 C2 .  C2 C3 . C2  . C3 C2 -
] n>d /SS 1

# Stream 2: Soaring Floating Anthem Lead Hook (4-Bar Donna Summer Phrase, 64 steps)
# Uses sustained ties '.' across 16ths and rests '-' for breathing pauses.
[
  # Bar 1 (over C): "Ooooh..."
  G4 . . .  C5 . . .  G4 . . -  E4 . . -
  # Bar 2 (over Eb): "...I feel..."
  Bb4 . . .  Eb5 . . .  Bb4 . . -  G4 . . -
  # Bar 3 (over F): "...love..."
  C5 . . .  F5 . . .  C5 . . -  A4 . . -
  # Bar 4 (over C): "...love, love!"
  G4 . E4 .  C5 . . .  G4 . . -  - - - -
] n>d /SS 2

# Stream 3: 16th Shimmer Arp Notes (4-Bar Locked Harmonic Progression, 64 steps)
[
  # Bar 1 (C shimmer)
  C4 G4 C5 G4  C4 G4 C5 G4  C4 G4 C5 G4  C4 G4 C5 G4
  # Bar 2 (Eb shimmer)
  Eb4 Bb4 Eb5 Bb4  Eb4 Bb4 Eb5 Bb4  Eb4 Bb4 Eb5 Bb4  Eb4 Bb4 Eb5 Bb4
  # Bar 3 (F shimmer)
  F4 C5 F5 C5  F4 C5 F5 C5  F4 C5 F5 C5  F4 C5 F5 C5
  # Bar 4 (C shimmer)
  C4 G4 C5 G4  C4 G4 C5 G4  C4 G4 C5 G4  C4 G4 C5 G4
] n>d /SS 3

# ----------------------------------------------------------------------
# PATTERNS (Demonstrating yl explicit lengths & ycp cloning)
# ----------------------------------------------------------------------

# Pattern 0: Four-on-the-Floor Kick + Sub-Weight
y0 %1
yl 16
[v0 l1 v5 g0 n48 g.06 n24 l1] x0,4,8,12

# Pattern 1: Disco Snare & Claps on 2 and 4 (Steps 4 and 12)
y1 %1
yl 16
[v1 l.5 v4 l.7] x4,12

# Pattern 2: Sizzling 16th Disco Hats (Running closed + offbeat sizzles)
y2 %1
yl 16
[v2 l.35] x0,1,2,3,4,5,6,7
[v2 l.35] x8,9,10,11,12,13,14,15
[v3 l.6] x2,6,10,14

# Pattern 3: The Hypnotic Octave Gallop Bass (Pulls dynamically via i&0)
y3 %1
yl 16
[v6 i&0] x0,1,2,3,4,5,6,7
[v6 i&0] x8,9,10,11,12,13,14,15

# Pattern 4: Kick Variation (Cloned from Pattern 0 using ycp, then accented)
0 4 ycp
4 y
[v0 l1 v5 g0 n48 g.06 n24 l1] x0,4,8,10,12,14

# Pattern 5: Snare Roll Fill (Cloned from Pattern 1, then with 16th roll)
1 5 ycp
5 y
[v1 l.4] x12,13,14,15
[v4 l.7] x12

# Pattern 6: 16th Shimmer Arpeggio (Pulls from Stream 3 via i&3)
y6 %1
yl 16
[v11 i&3] x0,1,2,3,4,5,6,7
[v11 i&3] x8,9,10,11,12,13,14,15

# Pattern 7: Soaring Anthem Lead (Pulls from Stream 2 via i&2 with ties & rests)
y7 %1
yl 16
[v13 i&2] x0,1,2,3,4,5,6,7
[v13 i&2] x8,9,10,11,12,13,14,15

# Pattern 8: Funky Syncopated Bass Variation (Pulls from Stream 1 via i&1)
y8 %1
yl 16
[v6 i&1] x0,1,2,3,4,5,6,7
[v6 i&1] x8,9,10,11,12,13,14,15

# Pattern 127: The Master Conductor (16 steps per bar)
y127 %1
yl 16
[v0] x15 yp127

# ----------------------------------------------------------------------
# SCENE MATRIX & ARRANGER
# Lanes: 0:Kick 1:Snare 2:Hats 3:Bass 4:Arp 5:Lead
# ----------------------------------------------------------------------
# Scene 0: Hypnotic Intro (4-on-floor Kick, Sizzling Hats, Octave Bass)
( 0 -1 2 3 -1 -1 -1 127 ) scene_define 0

# Scene 1: The Full "I Feel Love" Anthem (Kick, Snare/Clap, Hats, Bass, Shimmer Arp, Soaring Lead)
( 0 1 2 3 6 7 -1 127 ) scene_define 1

# Scene 2: High Energy Climax / Fill (Kick Variation, Snare Roll, Hats, Funky Bass, Arp, Lead)
( 4 5 2 8 6 7 -1 127 ) scene_define 2

# ----------------------------------------------------------------------
# AUTOMATED SCENE CHAINING
# Scene 0 loops 4 times -> auto-transitions to Scene 1
# Scene 1 loops 8 times -> auto-transitions to Scene 2
# Scene 2 loops 4 times -> auto-loops back to Scene 1
# ----------------------------------------------------------------------
0 4 1 scene_chain
1 8 2 scene_chain
2 4 1 scene_chain

# ----------------------------------------------------------------------
# PRECOMPILED REALTIME MACROS (Instant e! trigger)
# ----------------------------------------------------------------------
# Slot 0: Accent kick on downbeat
[v0 a-0.5 n36] e> 0

# Slot 1: Filter sweep / breakdown on bass (muffled warm pulse)
[v6 k180] e> 1

# Slot 2: Filter sweep / open up (bright and sizzling)
[v6 k550] e> 2

# Slot 3: Reset bass filter to standard punch
[v6 k260] e> 3

# === PLAYBACK CONTROLS ===
[start_disco] : ?ce! /cer 1 Z0 Z! scene_now 0 ;

[RAD DISCO READY - Type 'start_disco' or 'play' to launch the automated "I Feel Love" arrangement!] puts
[Commands: scene_cue 0 (hypnotic bass), scene_cue 1 (anthem), scene_cue 2 (climax)] puts
[Live tweaks: 0 4 ycp (re-clone kick), e! 1 (muffled filter drop), e! 2 (filter open sweep)] puts
