# ======================================================================
#  RAD DISCO ("I Feel Love" Giorgio Moroder Space-Disco Vibe)
#  126 BPM, C Major/Modal, Hypnotic PolyBLEP Octave Bass & Floating Lead
# ======================================================================

[RAD DISCO - "I FEEL LOVE" MORODER DISCO VIBES] puts
V -7.0
M 126 16

# ----------------------------------------------------------------------
# DELAY BUSES (Tempo-synced to 126 BPM)
# ----------------------------------------------------------------------
# Bus 1: The Iconic Moroder 16th Ping-Pong Gallop Delay
DS 1 126 .25
DL 1 - - 7 2 2 10
DD 1 6 3
DP 1 1

# Bus 2: Dotted-Eighth Floating Space Echo for Donna Summer Lead
DS 2 126 .75
DL 2 - - 8 3 3 11
DD 2 7 3
DP 2 1

# ----------------------------------------------------------------------
# SYNTHESIS VOICES
# ----------------------------------------------------------------------
# DRUMS (Munich Disco Kit)
v0 w82 f440 a6.0 p0                          # 4-on-the-floor punch kick
v1 w83 f440 a6.0 r1 p0 ds.25                 # Crisp disco snare
v2 w84 f440 a-3.5 p.2                        # 16th closed hi-hat
v3 w85 f440 a-1.5 p-.25                      # Sizzling offbeat open hi-hat
v4 w86 f440 a5.5 r1 p0 ds.3                  # Wide stereo disco clap
v5 w0 a-2.0 p0 t.002,.28,0,.08 j1 k180 q.8   # Sub kick weight (sine pitch drop)

# BASS: The Authentic Moroder Modular Moog Bass
# Voice 6: PolyBLEP Saw Up (w3) -> Driven 24dB ladder filter + resonance
v6 w3 a-2.5 p0 t.002,.12,.1,.04 j1,1 k520 q3.8 ft.001,.10,0,.04 fd2400 c4,.35 r1 ds.35
v6 >7
# Voice 7: PolyBLEP Pulse (w1) with active PWM envelope modulation
v7 w1 a-4.5 N0,5 p0 pw 0.35 pwt .005,.12,.2,.06 pwd 0.25 r1 ds.35
v6 G7 H7

# SHIMMER ARPEGGIATOR: Roland Jupiter / Odyssey 16th Pulse
v11 w1 a-8.0 p-.35 pw 0.25 t.002,.10,0,.04 j1 k3400 q2.0 r1 ds.35

# LEAD: Soaring "Donna Summer" Anthem Lead
# Detuned dual-saw with slow lush attack, filter swell, and space delay
v13 w3 a-7.0 p0 t.008,.35,.5,.20 j1,1 k4400 q1.5 c4,.25 ct.002,.25,0,.15 cd.3 r2 ds.4
v13 >14
v14 w2 a-9.0 p-.5 N0,7 r0
v13 G14 H14

# ----------------------------------------------------------------------
# NOTE STREAMS (Using /SS with rest '-', tie '.', and slur '~' options)
# ----------------------------------------------------------------------
# Stream 0: The Hypnotic 4-Bar Octave Gallop (C -> Eb -> F -> C)
# Playing with i&0 handles attacks on notes, ties on '.', and releases on '-'
[
  # Bar 1: C major gallop
  C2 C3 . C2  . C3 . C2  C2 C3 . C2  . C3 C2 -
  # Bar 2: Eb major gallop
  Eb2 Eb3 . Eb2  . Eb3 . Eb2  Eb2 Eb3 . Eb2  . Eb3 Eb2 -
  # Bar 3: F major gallop
  F2 F3 . F2  . F3 . F2  F2 F3 . F2  . F3 F2 -
  # Bar 4: C major return
  C2 C3 . C2  . C3 . C2  C2 C3 . C2  . C3 C2 -
] n>d /SS 0

# Stream 1: Funky Syncopated Bass Variation with Legato Slurs
[
  # Bar 1: C syncopated
  C2 . C3 C2  . C3 C2 .  C2 C3 . C2  ~D2 ~Eb2 C2 -
  # Bar 2: Eb syncopated
  Eb2 . Eb3 Eb2  . Eb3 Eb2 .  Eb2 Eb3 . Eb2  ~F2 ~G2 Eb2 -
  # Bar 3: F syncopated
  F2 . F3 F2  . F3 F2 .  F2 F3 . F2  ~G2 ~Ab2 F2 -
  # Bar 4: C turnaround
  C2 . C3 C2  . C3 C2 .  Bb1 . G1 .  C2 C3 C2 -
] n>d /SS 1

# Stream 2: Soaring Floating Anthem Lead Hook (4-Bar Donna Summer Phrase)
# Long expressive held notes using ties '.' over the galloping bass
[
  # Bar 1 (over C): "Ooooh..."
  G4 . . .  C5 . . .  G4 . . -  E4 . . -
  # Bar 2 (over Eb): "...I feel..."
  Bb4 . . .  Eb5 . . .  Bb4 . . -  G4 . . -
  # Bar 3 (over F): "...love..."
  C5 . . .  F5 . . .  C5 . . -  A4 . . -
  # Bar 4 (over C): "...love, love!"
  G4 . E4 .  C5 . . .  G4 . . -  - - - -
] n>d /SS 2

# Stream 3: 16th Shimmer Arp Notes
[
  C4 E4 G4 C5  Eb4 G4 Bb4 Eb5  F4 A4 C5 F5  E4 G4 C5 E5
] n>d /SS 3

# ----------------------------------------------------------------------
# PATTERNS (Demonstrating yl explicit lengths & ycp cloning)
# ----------------------------------------------------------------------

# Pattern 0: Four-on-the-Floor Kick + Sub-Weight
y0 %1
yl 16
[v0 l1 v5 g0 n48 g.06 n24 l1] x0,4,8,12

# Pattern 1: Disco Snare on 2 and 4 + Claps
y1 %1
yl 16
[v1 l.5 v4 l.7] x4,12

# Pattern 2: Sizzling 16th Disco Hats (Running closed + offbeat sizzles)
y2 %1
yl 16
[v2 l.35] x0,1,2,3,4,5,6,7
[v2 l.35] x8,9,10,11,12,13,14,15
[v3 l.6] x2,6,10,14

# Pattern 3: The Hypnotic Octave Gallop Bass (Pulls dynamically via i&0)
y3 %1
yl 16
[v6 i&0] x0,1,2,3,4,5,6,7
[v6 i&0] x8,9,10,11,12,13,14,15

# Pattern 4: Kick Variation (Cloned from Pattern 0 using ycp, then accented)
0 4 ycp
4 y
[v0 l1 v5 g0 n48 g.06 n24 l1] x0,4,8,10,12,14

# Pattern 5: Snare Roll Fill (Cloned from Pattern 1, then with 16th roll)
1 5 ycp
5 y
[v1 l.4] x12,13,14,15
[v4 l.7] x12

# Pattern 6: 16th Shimmer Arpeggio (Pulls from Stream 3 via i&3)
y6 %1
yl 16
[v11 i&3] x0,1,2,3,4,5,6,7
[v11 i&3] x8,9,10,11,12,13,14,15

# Pattern 7: Soaring Anthem Lead (Pulls from Stream 2 via i&2 with ties & rests)
y7 %1
yl 16
[v13 i&2] x0,1,2,3,4,5,6,7
[v13 i&2] x8,9,10,11,12,13,14,15

# Pattern 8: Funky Syncopated Bass Variation (Pulls from Stream 1 via i&1)
y8 %1
yl 16
[v6 i&1] x0,1,2,3,4,5,6,7
[v6 i&1] x8,9,10,11,12,13,14,15

# Pattern 127: The Master Conductor (16 steps per bar)
y127 %1
yl 16
[v0] x15 yp127

# ----------------------------------------------------------------------
# SCENE MATRIX & ARRANGER
# Lanes: 0:Kick 1:Snare 2:Hats 3:Bass 4:Arp 5:Lead
# ----------------------------------------------------------------------
# Scene 0: Hypnotic Intro (4-on-floor Kick, Sizzling Hats, Octave Bass)
( 0 -1 2 3 -1 -1 -1 127 ) scene_define 0

# Scene 1: The Full "I Feel Love" Anthem (Kick, Snare/Clap, Hats, Bass, Shimmer Arp, Soaring Lead)
( 0 1 2 3 6 7 -1 127 ) scene_define 1

# Scene 2: High Energy Climax / Fill (Kick Variation, Snare Roll, Hats, Funky Bass, Arp, Lead)
( 4 5 2 8 6 7 -1 127 ) scene_define 2

# ----------------------------------------------------------------------
# AUTOMATED SCENE CHAINING
# Scene 0 loops 4 times -> auto-transitions to Scene 1
# Scene 1 loops 8 times -> auto-transitions to Scene 2
# Scene 2 loops 4 times -> auto-loops back to Scene 1
# ----------------------------------------------------------------------
0 4 1 scene_chain
1 8 2 scene_chain
2 4 1 scene_chain

# ----------------------------------------------------------------------
# PRECOMPILED REALTIME MACROS (Instant e! trigger)
# ----------------------------------------------------------------------
# Slot 0: Big crash / kick accent on downbeat
[v0 a6.5 n36 v1 a6.0] e> 0

# Slot 1: Filter sweep / breakdown on bass (muffled)
[v6 k200] e> 1

# Slot 2: Filter sweep / open up (bright and sizzling)
[v6 k750] e> 2

# Slot 3: Reset bass filter to standard punch
[v6 k520] e> 3

# === PLAYBACK CONTROLS ===
[play] : ?ce! /cer 1 Z0 Z! scene_now 0 ;
[stop] : /cer 0 Z0 O DQ ?ce! ;

[RAD DISCO READY - Type 'play' to launch the automated "I Feel Love" arrangement!] puts
[Commands: scene_cue 0 (hypnotic bass), scene_cue 1 (anthem), scene_cue 2 (climax)] puts
[Live tweaks: 0 4 ycp (re-clone kick), e! 1 (muffled filter drop), e! 2 (filter open sweep)] puts
