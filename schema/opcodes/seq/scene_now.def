@name     scene_now
@alias    scene_now
@group    seq
@type     realtime
@arity    1
@match    (finite)
@summary  switch scene immediately across all lanes
@doc
Switches active scene immediately without downbeat quantization.
Usage: scene_now scene_id (or scene_id scene_now)
@code
    (void)voice;
    seq_scene_now((int)args[0]);
    return 0;
@end
