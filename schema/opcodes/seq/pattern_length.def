@name     pattern_length
@alias    yl
@group    seq
@c_name   skode_clause_pattern_length_1
@type     immediate
@arity    1
@match    (finite)
@summary  set explicit pattern length in steps
@doc
Sets explicit pattern length in steps for active pattern.
Usage: pattern_length steps (or steps pattern_length, steps yl)
@code
    (void)s; (void)argc;
    if (!ctx) return -1;
    seq_pattern_length_set(ctx->pattern, (int)args[0]);
    return 0;
@end

@name     pattern_length
@alias    yl
@group    seq
@c_name   skode_clause_pattern_length_2
@type     immediate
@arity    2
@match    (finite, finite)
@summary  set explicit pattern length for specific pattern
@doc
Sets explicit pattern length in steps for specified pattern (pattern, steps).
Usage: pattern_length pattern steps
@code
    (void)ctx; (void)s; (void)argc;
    seq_pattern_length_set((int)args[0], (int)args[1]);
    return 0;
@end
