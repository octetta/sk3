@name     pattern_hz
@alias    pattern_hz
@group    seq
@c_name   skode_clause_pattern_hz_1
@type     immediate
@arity    1
@match    (finite)
@summary  set pattern rate in isochronous Hz
@doc
Sets isochronous playback frequency in Hz for active pattern (e.g. 50 for PAL SID, 60 for NTSC).
Usage: pattern_hz hz (or hz pattern_hz)
@code
    (void)s; (void)argc;
    if (!ctx) return -1;
    seq_pattern_hz_set(ctx->pattern, (float)args[0]);
    return 0;
@end

@name     pattern_hz
@alias    pattern_hz
@group    seq
@c_name   skode_clause_pattern_hz_2
@type     immediate
@arity    2
@match    (finite, finite)
@summary  set pattern rate in isochronous Hz for specific pattern
@doc
Sets isochronous playback frequency in Hz for specified pattern (pattern, hz).
Usage: pattern_hz pattern hz
@code
    (void)ctx; (void)s; (void)argc;
    seq_pattern_hz_set((int)args[0], (float)args[1]);
    return 0;
@end
