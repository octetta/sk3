@name     pwm_env_depth
@alias    pwd
@group    env
@c_name   skode_clause_pwm_env_depth
@type     immediate
@arity    1
@match    (finite)
@summary  set pulse width envelope depth
@doc
Sets modulation depth for voice pulse width envelope (-1.0 .. 1.0).
Usage: pwd depth
@code
    if (!ctx) return -1;
    (void)s; (void)argc;
    sv.pwm_env_depth[ctx->voice] = (float)args[0];
    return 0;
@end
