@name     stop
@group    sys
@c_name   skode_clause_sys_stop
@type     immediate
@arity    0
@match    ()
@summary  stop audio playback and halt sequencer
@doc
Stops playback, halts all sequencer patterns, and mutes sounding voices.
Usage: stop
@code
    (void)args; (void)argc;
    seq_state_all(SEQ_STOPPED);
    seq_scene_stop();
    skode_exec_O(ctx, s, NULL, 0);
    skode_exec_DQ(ctx, s, NULL, 0);
    skred_control_event_clear();
    skred_control_response_set_enabled(0);
    return 0;
@end
